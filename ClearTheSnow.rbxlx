		for _, s in { -1, 1 } do
			cylY(g, 0.25, 0.08, st("#212121"), s * 1.05, 0.1, -1.8)
			for i = 0, 11 do
				local a = i / 12 * math.pi * 2
				box(g, 0.02, 0.08, 0.12, st("#ffca28"), s * 1.05 + math.cos(a) * 0.25, 0.08, -1.8 + math.sin(a) * 0.25, 0, -a, 0)
