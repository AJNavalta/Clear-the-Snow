		headlight(g, 0.1, -0.8, 1.9, 2.0)
		headlight(g, 0.1, 0.8, 1.9, 2.0)
		seat(g, -0.45, 2.15, 0.1, 1.1)
		steering(g, -0.45, 2.55, 0.6, 0.7)
