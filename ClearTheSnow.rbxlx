		local white = st("#eceff1")
		box(g, 2.0, 0.35, 7.0, M.dark, 0, 0.85, -0.6)
		box(g, 2.4, 1.6, 1.8, paint, 0, 2.1, 1.6)
		box(g, 2.42, 0.2, 1.82, white, 0, 1.6, 1.6)
		box(g, 2.2, 0.85, 0.02, M.glass, 0, 2.45, 2.51)
		for _, s in { -1, 1 } do
			box(g, 0.02, 0.75, 1.3, M.glass, s * 1.21, 2.45, 1.7)
			mirror(g, s * 1.2, 2.6, 2.3, s)
		end
		box(g, 2.2, 0.15, 0.3, M.black, 0, 3.0, 2.3)
		for i = 0, 5 do
			box(g, 0.25, 0.08, 0.02, M.light, -0.8 + i * 0.32, 3.0, 2.46)
		end
		beacon(g, -1.0, 2.95, 1.0)
		beacon(g, 1.0, 2.95, 1.0)
		seat(g, -0.5, 1.75, 1.4, 1.1)
		steering(g, -0.5, 2.2, 2.0, 0.9)
		box(g, 2.3, 1.4, 2.0, paint, 0, 2.0, -0.4)
		for i = 0, 7 do
			box(g, 0.02, 0.9, 0.12, M.black, 1.16, 2.0, -1.2 + i * 0.22)
		end
		cylY(g, 0.1, 1.4, M.chrome, 0.9, 3.2, -0.9)
		box(g, 2.4, 0.12, 2.8, paint, 0, 1.1, -2.9)
		for _, s in { -1, 1 } do
			box(g, 0.08, 1.2, 2.8, paint, s * 1.18, 1.7, -2.9)
			box(g, 0.15, 0.3, 0.05, M.tail, s * 1.05, 0.9, -4.35)
		end
		box(g, 2.4, 1.2, 0.08, paint, 0, 1.7, -4.28)
		box(g, 2.4, 1.2, 0.08, paint, 0, 1.7, -1.52)
		for i = 0, 4 do
			box(g, 0.05, 1.1, 0.05, M.dark, 1.24, 1.7, -4.1 + i * 0.6)
		end
		load(g, 2.25, 0.9, 2.6, 0, 1.15, -2.9)
		-- rotary head: two drums, impeller and chute
		local head = sub(g, 0, 0, 3.0)
		box(head, 3.4, 1.6, 0.1, paint, 0, 1.0, -0.5)
		box(head, 3.4, 0.1, 1.2, paint, 0, 1.75, 0.05)
		for _, s in { -1, 1 } do
			box(head, 0.1, 1.6, 1.2, paint, s * 1.7, 1.0, 0.05)
			local drum = sub(head, s * 0.85, 0.85, 0.1)
			cylZ(drum, 0.12, 0.9, M.steel, 0, 0, 0)
			for i = 0, 17 do
				local t = i / 18
				local a = t * math.pi * 4
				box(drum, 0.08, 0.6, 0.05, st("#fdd835", Enum.Material.Metal), math.cos(a) * 0.4, math.sin(a) * 0.4, -0.4 + t * 0.85, 0, 0, a)
			end
		end
		box(head, 3.4, 0.08, 0.15, M.steel, 0, 0.06, 0.6)
		cylY(head, 0.3, 1.6, paint, 0, 2.5, -0.3)
		box(head, 0.6, 0.25, 0.7, paint, 0, 3.3, -0.05, 0.35, 0, 0)
		for _, wz in { 1.0, -2.3, -3.6 } do
			for _, s in { -1, 1 } do
				wheel(g, 0.55, 0.4, s * 1.05, 0.55, wz, { lugs = 22, nuts = 10 })
			end
		end
		headlight(g, 0.09, -0.9, 1.35, 2.52)
		headlight(g, 0.09, 0.9, 1.35, 2.52)
		seatPos = v(-0.5, 1.8, 1.4)
	end

	model:SetAttribute("SeatOffset", seatPos * S)
	model:SetAttribute("Standing", standing)
	return finish(model)
end

function Models.Build(id: string): Model
	local tool = Config.GetTool(id)
	if tool.kind == "hand" then
		return Models.BuildHandTool(id)
	end
	return Models.BuildMachine(id)
end

-- ------------------------------------------------------------------ people & props
-- Blocky NPC (no Humanoid), feet at origin, facing -Z.
function Models.BuildNPC(coat: string, hat: string, scarf: string): Model
	local model, g = newModel("Vendor")
	local skin = st("#f1c6a0")
	local pants = st("#3e2723", Enum.Material.Fabric)
	box(g, 0.18, 0.75, 0.2, pants, -0.12, 0.45, 0)
	box(g, 0.18, 0.75, 0.2, pants, 0.12, 0.45, 0)
	box(g, 0.2, 0.12, 0.3, st("#3a2a20"), -0.12, 0.06, 0.04)
	box(g, 0.2, 0.12, 0.3, st("#3a2a20"), 0.12, 0.06, 0.04)
	box(g, 0.55, 0.7, 0.32, st(coat, Enum.Material.Fabric), 0, 1.18, 0)
	box(g, 0.02, 0.6, 0.02, M.steel, 0, 1.18, 0.17)
	cylY(g, 0.17, 0.12, st(scarf, Enum.Material.Fabric), 0, 1.56, 0)
	box(g, 0.09, 0.3, 0.04, st(scarf, Enum.Material.Fabric), 0.1, 1.4, 0.18, 0, 0, 0.15)
	box(g, 0.16, 0.62, 0.18, st(coat, Enum.Material.Fabric), -0.36, 1.2, 0)
	box(g, 0.16, 0.62, 0.18, st(coat, Enum.Material.Fabric), 0.36, 1.2, 0)
	ball(g, 0.085, st("#24324a", Enum.Material.Fabric), -0.36, 0.86, 0)
	ball(g, 0.085, st("#24324a", Enum.Material.Fabric), 0.36, 0.86, 0)
	ball(g, 0.2, skin, 0, 1.8, 0)
	ball(g, 0.025, M.black, -0.07, 1.83, 0.18)
	ball(g, 0.025, M.black, 0.07, 1.83, 0.18)
	ball(g, 0.035, st("#f08a7a"), 0, 1.78, 0.2)
	cylY(g, 0.21, 0.16, st(hat, Enum.Material.Fabric), 0, 1.95, 0)
	cylY(g, 0.22, 0.07, st("#e8eef7", Enum.Material.Fabric), 0, 1.87, 0)
	ball(g, 0.07, st("#e8eef7", Enum.Material.Fabric), 0, 2.08, 0)
	return finish(model)
end

-- Market stall with counter, striped awning and a sign. Faces -Z after finishing.
function Models.BuildStall(color: string, stripe: string, sign: string, width: number): Model
	local model, g = newModel("Stall")
	local wood = M.wood
	box(g, width, 1.0, 0.8, wood, 0, 0.5, 0.6)
	box(g, width + 0.1, 0.08, 0.95, st("#6d4c41", Enum.Material.Wood), 0, 1.04, 0.6)
	for _, x in { -width / 2 + 0.1, width / 2 - 0.1 } do
		box(g, 0.12, 2.6, 0.12, wood, x, 1.3, 0.95)
		box(g, 0.12, 2.9, 0.12, wood, x, 1.45, -0.4)
	end
	box(g, width, 2.6, 0.1, st("#8d6e63", Enum.Material.Wood), 0, 1.4, -0.45)
	local stripes = 9
	for i = 0, stripes - 1 do
		local w = width / stripes
		local c = if i % 2 == 1 then stripe else color
		box(g, w, 0.06, 1.7, st(c, Enum.Material.Fabric), -width / 2 + w * (i + 0.5), 2.85, 0.4, 0.22, 0, 0)
		box(g, w, 0.3, 0.04, st(c, Enum.Material.Fabric), -width / 2 + w * (i + 0.5), 2.55, 1.25)
	end
	box(g, width, 0.08, 1.6, M.snow, 0, 2.95, 0.38, 0.22, 0, 0)
	local board = box(g, width * 0.82, width * 0.22, 0.08, st("#3e2723", Enum.Material.Wood), 0, 3.4, -0.34)
	board.Name = "SignBoard"
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back -- +Z before finishing, so it faces the customers afterwards
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.Parent = board
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Text = sign
	tl.TextScaled = true
	tl.Font = Enum.Font.FredokaOne
	tl.TextColor3 = Color3.fromHex("#fff8e1")
	tl.Parent = sg
	return finish(model)
end

-- Spin wheel disc (8 coloured triangles + labels), centre at origin, facing -Z (toward
-- whoever stands in front of it). Segment i is centred at the top when the disc's Z
-- rotation equals i * 45 degrees.
function Models.BuildWheel(radiusM: number): Model
	local model, g = newModel("Wheel")
	local n = #Config.Wheel
	local seg = math.pi * 2 / n
	local r = radiusM
	for i, s in Config.Wheel do
		local centre = math.pi / 2 - (i - 1) * seg
		local a0, a1 = centre - seg / 2, centre + seg / 2
		tri(g, v(0, 0, 0), v(math.cos(a0) * r, math.sin(a0) * r, 0), v(math.cos(a1) * r, math.sin(a1) * r, 0), 0.06, st(s.color))
		-- label plate along the segment's radius
		local plate = box(g, r * 0.62, r * 0.16, 0.01, st(s.color), math.cos(centre) * r * 0.56, math.sin(centre) * r * 0.56, 0.04, 0, 0, centre)
		plate.Transparency = 1
		plate.Name = "Label" .. i
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Back
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 50
		sg.LightInfluence = 0
		sg.Parent = plate
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Text = s.label
		tl.TextScaled = true
		tl.Font = Enum.Font.FredokaOne
		tl.TextColor3 = Color3.new(1, 1, 1)
		tl.TextStrokeTransparency = 0.4
		tl.Parent = sg
		-- rim pegs
		ball(g, 0.06, st("#ffffff", Enum.Material.Neon), math.cos(a0) * r, math.sin(a0) * r, 0.04)
	end
	-- gold rim made of short segments, and a hub
	for k = 0, 31 do
		local a = k / 32 * math.pi * 2
		box(g, 0.12, r * 2 * math.sin(math.pi / 32) * 1.1, 0.12, st("#ffd54f", Enum.Material.Metal), math.cos(a) * r, math.sin(a) * r, 0, 0, 0, a)
	end
	cylZ(g, r * 0.15, 0.14, st("#ffd54f", Enum.Material.Metal), 0, 0, 0.02)
	return finish(model)
end


-- ------------------------------------------------------------------ scenery
-- Low-poly pine: six-sided cone tiers with a snowy top. Origin at the trunk base.
function Models.BuildPine(k: number): Model
	local model, g = newModel("Pine")
	cylY(g, 0.2 * k, 1.2 * k, st("#5d4037", Enum.Material.Wood), 0, 0.6 * k, 0)
	local green = st("#2f5d3a", Enum.Material.Grass)
	local sides = 6
	for tier = 0, 2 do
		local r = (1.7 - tier * 0.45) * k
		local h = 1.7 * k
		local y = (1.0 + tier * 1.05) * k
		local style = if tier == 2 then M.snow else green
		local apex = v(0, y + h, 0)
		for i = 0, sides - 1 do
			local a0, a1 = i / sides * math.pi * 2, (i + 1) / sides * math.pi * 2
			tri(g, apex, v(math.cos(a0) * r, y, math.sin(a0) * r), v(math.cos(a1) * r, y, math.sin(a1) * r), 0.08, style)
		end
		-- snow ring on the lower tiers
		if tier < 2 then
			cylY(g, r * 0.45, 0.12 * k, M.snow, 0, y + h * 0.62, 0)
		end
	end
	return model
end

-- House with a gabled, snow-covered roof. Front door faces -Z after finishing.
function Models.BuildHouse(w: number, d: number, color: string, extras: boolean): Model
	local model, g = newModel("House")
	local wall = st(color, Enum.Material.Brick)
	local trim = st("#f5f1e8")
	local roof = st("#5d4037", Enum.Material.Slate)
	local h = 3.2
	box(g, w, h, d, wall, 0, h / 2, 0)
	box(g, w + 0.1, 0.3, d + 0.1, st("#8e8e8e", Enum.Material.Concrete), 0, 0.15, 0)
	-- gable ends
	local rh = 2.2
	for _, x in { -w / 2, w / 2 } do
		tri(g, v(x, h, -d / 2), v(x, h, d / 2), v(x, h + rh, 0), 0.1, wall)
	end
	-- roof planes and snow
	local half = d / 2 + 0.5
	local slope = math.atan2(rh, half)
	local len = math.sqrt(half * half + rh * rh)
	for _, s in { -1, 1 } do
		box(g, w + 0.8, 0.15, len, roof, 0, h + rh / 2, s * half / 2, s * slope, 0, 0)
		box(g, w + 0.9, 0.18, len * 0.98, M.snow, 0, h + rh / 2 + 0.16, s * half / 2, s * slope, 0, 0)
	end
	box(g, 0.7, 2, 0.7, st("#8d4b3a", Enum.Material.Brick), w * 0.25, h + 1.6, -d * 0.15)
	box(g, 0.8, 0.15, 0.8, M.snow, w * 0.25, h + 2.65, -d * 0.15)
	-- front (+Z here)
	box(g, 1.1, 2.1, 0.08, st("#5b3a29", Enum.Material.Wood), 0, 1.05, d / 2 + 0.04)
	ball(g, 0.05, st("#d4af37", Enum.Material.Metal), 0.4, 1.05, d / 2 + 0.1)
	box(g, 1.3, 0.12, 0.1, trim, 0, 2.15, d / 2 + 0.05)
	local win = st("#ffe7a3", Enum.Material.Neon)
	for _, x in { -w * 0.3, w * 0.3 } do
		box(g, 1.2, 1.0, 0.06, win, x, 1.8, d / 2 + 0.03)
		box(g, 1.35, 0.1, 0.12, trim, x, 1.25, d / 2 + 0.06)
		box(g, 0.06, 1.0, 0.1, trim, x, 1.8, d / 2 + 0.06)
		box(g, 1.2, 0.06, 0.1, trim, x, 1.8, d / 2 + 0.06)
	end
	for _, s in { -1, 1 } do
		box(g, 0.06, 1.0, 1.2, win, s * (w / 2 + 0.03), 1.8, 0)
	end
	box(g, 1.8, 0.2, 0.8, st("#9e9e9e", Enum.Material.Concrete), 0, 0.1, d / 2 + 0.4)
	-- wreath
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		ball(g, 0.08, st("#2e7d32", Enum.Material.Grass), math.cos(a) * 0.2, 1.6 + math.sin(a) * 0.2, d / 2 + 0.12)
	end
	ball(g, 0.07, st("#c62828"), 0, 1.4, d / 2 + 0.16)
	if extras then
		cylY(g, 0.05, 1.1, st("#5d4037", Enum.Material.Wood), w * 0.45, 0.55, d / 2 + 2.6)
		box(g, 0.3, 0.25, 0.45, st("#263238", Enum.Material.Metal), w * 0.45, 1.2, d / 2 + 2.6)
	end
	return finish(model)
end

function Models.BuildLamp(): Model
	local model, g = newModel("Lamp")
	local iron = st("#1f2a33", Enum.Material.Metal)
	cylY(g, 0.1, 4, iron, 0, 2, 0)
	cylY(g, 0.25, 0.3, iron, 0, 0.15, 0)
	local bulb = box(g, 0.4, 0.5, 0.4, st("#fff3c4", Enum.Material.Neon), 0, 4.2, 0)
	box(g, 0.55, 0.08, 0.55, iron, 0, 4.48, 0)
	box(g, 0.6, 0.08, 0.6, M.snow, 0, 4.55, 0)
	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = 1.2
	light.Color = Color3.fromHex("#ffd27a")
	light.Shadows = false
	light.Parent = bulb
	return model
end

function Models.BuildGift(): Model
	local model, g = newModel("Gift")
	local purple, gold = st("#8e24aa"), st("#ffd54f", Enum.Material.Metal)
	box(g, 1.1, 1.0, 1.1, purple, 0, 0.5, 0)
	box(g, 1.2, 0.2, 1.2, purple, 0, 1.08, 0)
	box(g, 0.2, 1.22, 1.14, gold, 0, 0.6, 0)
	box(g, 1.14, 1.22, 0.2, gold, 0, 0.6, 0)
	for _, s in { -1, 1 } do
		box(g, 0.06, 0.35, 0.35, gold, s * 0.18, 1.32, 0, 0.785, 0, s * 0.5)
	end
	return model
end

-- ------------------------------------------------------------------ event models
local function reindeer(g: Frame, x: number, z: number, lead: boolean)
	local fur = st("#7b5236", Enum.Material.Fabric)
	local belly = st("#c9a27e", Enum.Material.Fabric)
	local hoof = st("#2b211b")
	local r = sub(g, x, 0, z)
	blob(r, 0.36, 0.38, 0.85, fur, 0, 0.95, 0)
	blob(r, 0.28, 0.2, 0.6, belly, 0, 0.85, 0)
	blob(r, 0.14, 0.14, 0.12, st("#f3eee6", Enum.Material.Fabric), 0, 1.02, -0.43) -- tail
	for _, lx in { -0.11, 0.11 } do
		for _, lz in { -0.28, 0.28 } do
			box(r, 0.07, 0.62, 0.08, fur, lx, 0.45, lz)
			box(r, 0.09, 0.08, 0.1, hoof, lx, 0.12, lz + 0.01)
		end
	end
	rod(r, v(0, 1.05, 0.33), v(0, 1.38, 0.52), 0.07, fur) -- neck
	blob(r, 0.2, 0.2, 0.34, fur, 0, 1.45, 0.62) -- head
	blob(r, 0.13, 0.12, 0.14, belly, 0, 1.41, 0.78) -- muzzle
	ball(r, 0.045, if lead then st("#ff2d2d", Enum.Material.Neon) else M.black, 0, 1.43, 0.86)
	ball(r, 0.025, M.black, -0.08, 1.5, 0.7)
	ball(r, 0.025, M.black, 0.08, 1.5, 0.7)
	box(r, 0.05, 0.1, 0.04, fur, -0.12, 1.55, 0.56, 0, 0, 0.7) -- ears
	box(r, 0.05, 0.1, 0.04, fur, 0.12, 1.55, 0.56, 0, 0, -0.7)
	local antler = st("#e2d2b0")
	for _, sx in { -1, 1 } do
		rod(r, v(sx * 0.06, 1.55, 0.6), v(sx * 0.2, 1.85, 0.55), 0.02, antler)
		rod(r, v(sx * 0.2, 1.85, 0.55), v(sx * 0.3, 2.0, 0.45), 0.018, antler)
		rod(r, v(sx * 0.15, 1.75, 0.57), v(sx * 0.12, 1.92, 0.68), 0.016, antler)
		rod(r, v(sx * 0.24, 1.92, 0.52), v(sx * 0.2, 2.06, 0.6), 0.015, antler)
	end
	-- harness collar with a gold bell
	cylZ(r, 0.11, 0.05, st("#b71c1c", Enum.Material.Fabric), 0, 1.15, 0.36)
	ball(r, 0.04, st("#ffd54f", Enum.Material.Metal), 0, 1.03, 0.4)
end

-- Santa's sleigh with Santa, his sack and three reindeer (two side by side, Rudolph in
-- front). Origin = ground under the sleigh; faces -Z in Roblox after finishing.
function Models.BuildSleigh(): Model
	local model, g = newModel("SantaSleigh")
	local red = st("#c62828")
	local gold = st("#ffcc33", Enum.Material.Metal)
	-- runners with curled fronts
	for _, x in { -0.42, 0.42 } do
		box(g, 0.05, 0.05, 1.7, gold, x, 0.08, 0)
		arc(g, 0.25, 0.85, 0.17, math.pi, -0.3, 7, 0.05, 0.05, gold, x)
		for _, z in { -0.5, 0.4 } do
			box(g, 0.04, 0.28, 0.04, gold, x, 0.24, z)
		end
	end
	-- body
	box(g, 0.95, 0.42, 1.4, red, 0, 0.6, -0.05)
	box(g, 0.95, 0.5, 0.12, red, 0, 1.0, -0.72) -- tall back
	box(g, 0.99, 0.06, 1.44, gold, 0, 0.83, -0.05)
	box(g, 0.95, 0.35, 0.1, red, 0, 0.9, 0.62, -0.5, 0, 0) -- front curl
	ball(g, 0.08, gold, -0.48, 1.25, -0.72)
	ball(g, 0.08, gold, 0.48, 1.25, -0.72)
	box(g, 0.85, 0.08, 0.5, st("#1b5e20", Enum.Material.Fabric), 0, 0.86, -0.4) -- seat
	-- the sack of presents
	blob(g, 0.6, 0.7, 0.5, st("#8d6e63", Enum.Material.Fabric), 0.15, 1.15, -0.55)
	box(g, 0.22, 0.22, 0.22, st("#2e7d32"), 0.05, 1.5, -0.55, 0.3, 0.4, 0)
	box(g, 0.2, 0.2, 0.2, st("#1565c0"), 0.28, 1.47, -0.5, 0.2, -0.5, 0.2)
	-- Santa
	local sx = -0.18
	box(g, 0.42, 0.5, 0.36, st("#d32f2f", Enum.Material.Fabric), sx, 1.15, -0.32)
	box(g, 0.44, 0.08, 0.38, M.black, sx, 1.02, -0.32)
	box(g, 0.1, 0.06, 0.02, gold, sx, 1.02, -0.12)
	box(g, 0.44, 0.1, 0.38, st("#ffffff", Enum.Material.Fabric), sx, 0.92, -0.32)
	for _, ax in { -0.26, 0.26 } do
		rod(g, v(sx + ax, 1.33, -0.32), v(sx + ax * 0.9, 1.12, 0.0), 0.075, st("#d32f2f", Enum.Material.Fabric))
		ball(g, 0.065, M.black, sx + ax * 0.85, 1.1, 0.04)
	end
	ball(g, 0.17, st("#f1c6a0"), sx, 1.55, -0.3)
	blob(g, 0.3, 0.28, 0.16, st("#ffffff", Enum.Material.Fabric), sx, 1.45, -0.18) -- beard
	ball(g, 0.035, st("#e57373"), sx, 1.56, -0.13) -- nose
	ball(g, 0.022, M.black, sx - 0.06, 1.6, -0.15)
	ball(g, 0.022, M.black, sx + 0.06, 1.6, -0.15)
	cylY(g, 0.18, 0.08, st("#ffffff", Enum.Material.Fabric), sx, 1.68, -0.3)
	rod(g, v(sx, 1.7, -0.3), v(sx + 0.08, 1.95, -0.42), 0.12, st("#d32f2f", Enum.Material.Fabric))
	ball(g, 0.06, st("#ffffff", Enum.Material.Fabric), sx + 0.1, 1.98, -0.46)
	-- reindeer and harness
	reindeer(g, -0.32, 1.6, false)
	reindeer(g, 0.32, 1.6, false)
	reindeer(g, 0, 2.75, true)
	local strap = st("#6d1b1b", Enum.Material.Fabric)
	rod(g, v(-0.3, 0.85, 0.6), v(-0.32, 1.12, 1.95), 0.02, strap)
	rod(g, v(0.3, 0.85, 0.6), v(0.32, 1.12, 1.95), 0.02, strap)
	rod(g, v(0, 1.12, 1.95), v(0, 1.12, 3.1), 0.02, strap)
	rod(g, v(-0.32, 1.12, 1.95), v(0.32, 1.12, 1.95), 0.02, strap)
	rod(g, v(sx - 0.22, 1.1, 0.04), v(-0.32, 1.12, 1.95), 0.01, M.black) -- reins
	rod(g, v(sx + 0.22, 1.1, 0.04), v(0.32, 1.12, 1.95), 0.01, M.black)
	return finish(model)
end

-- The Yeti: a big shaggy snow beast, about 4.6 m tall. Origin at its feet, faces -Z.
function Models.BuildYeti(): Model
	local model, g = newModel("Yeti")
	local fur = st("#eef3fa", Enum.Material.Snow)
	local shade = st("#d3dfee", Enum.Material.Snow)
	local skin = st("#6f8fb3")
	local dark = st("#22324a")
	-- legs and feet
	for _, x in { -0.45, 0.45 } do
		blob(g, 0.7, 1.4, 0.75, fur, x, 0.9, 0)
		blob(g, 0.6, 0.3, 0.9, skin, x, 0.15, 0.15)
		for _, t in { -0.18, 0, 0.18 } do
			ball(g, 0.07, st("#e9e2cf"), x + t, 0.1, 0.6)
		end
	end
	-- body
	blob(g, 2.0, 2.2, 1.5, fur, 0, 2.6, 0)
	blob(g, 1.2, 1.3, 0.4, shade, 0, 2.5, 0.6) -- chest
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		blob(g, 0.5, 0.6, 0.5, fur, math.cos(a) * 0.9, 1.65, math.sin(a) * 0.65) -- shaggy fringe
	end
	-- arms
	for _, sx in { -1, 1 } do
		local arm = sub(g, sx * 1.05, 3.2, 0, 0, 0, sx * 0.25)
		blob(arm, 0.7, 1.9, 0.7, fur, sx * 0.1, -0.9, 0)
		blob(arm, 0.55, 0.45, 0.6, skin, sx * 0.2, -1.9, 0.05)
		for _, t in { -0.15, 0, 0.15 } do
			box(arm, 0.06, 0.18, 0.06, st("#e9e2cf"), sx * 0.2 + t, -2.15, 0.2, 0.4, 0, 0)
		end
	end
	-- head
	blob(g, 1.3, 1.15, 1.2, fur, 0, 4.05, 0.05)
	blob(g, 0.9, 0.75, 0.3, skin, 0, 3.95, 0.55) -- face
	blob(g, 0.24, 0.16, 0.08, st("#ffffff"), -0.2, 4.12, 0.7)
	blob(g, 0.24, 0.16, 0.08, st("#ffffff"), 0.2, 4.12, 0.7)
	ball(g, 0.06, st("#d50000", Enum.Material.Neon), -0.2, 4.12, 0.74)
	ball(g, 0.06, st("#d50000", Enum.Material.Neon), 0.2, 4.12, 0.74)
	box(g, 0.3, 0.06, 0.06, dark, -0.2, 4.25, 0.7, 0, 0, -0.35) -- angry brows
	box(g, 0.3, 0.06, 0.06, dark, 0.2, 4.25, 0.7, 0, 0, 0.35)
	blob(g, 0.5, 0.25, 0.1, dark, 0, 3.75, 0.68) -- mouth
	for _, x in { -0.16, 0.16 } do
		box(g, 0.07, 0.14, 0.04, st("#ffffff"), x, 3.82, 0.72) -- fangs
	end
	-- horns
	local horn = st("#d9c9a3")
	for _, sx in { -1, 1 } do
		rod(g, v(sx * 0.45, 4.4, 0), v(sx * 0.8, 4.75, -0.1), 0.1, horn)
		rod(g, v(sx * 0.8, 4.75, -0.1), v(sx * 0.85, 5.05, 0.15), 0.07, horn)
	end
	return finish(model)
end

-- Decorated plaza tree.
function Models.BuildXmasTree(): Model
	local model = Models.BuildPine(1.5)
	local g = { model = model, cf = CFrame.new() }
	local colors = { "#e53935", "#ffd54f", "#42a5f5", "#ab47bc", "#66bb6a" }
	local rng = Random.new(7)
	for i = 1, 36 do
		local y = 1.6 + rng:NextNumber() * 4.4
		local r = math.max(0.3, (2.5 - (y - 1.5) * 0.5)) * 0.95
		local a = rng:NextNumber() * math.pi * 2
		ball(g, 0.13, st(colors[i % #colors + 1], Enum.Material.Neon), math.cos(a) * r, y, math.sin(a) * r)
	end
	ball(g, 0.3, st("#ffd54f", Enum.Material.Neon), 0, 7.2, 0)
	return model
end

-- Anchor or weld a model for use. When `weldTo` is given, every part is unanchored,
-- massless and welded to the model's Root.
function Models.Weld(model: Model)
	local root = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Massless = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			if d ~= root then
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = d
				w.Parent = d
			end
			d.Anchored = false
		end
	end
end

-- Weld every part to the Root and keep only the Root anchored. Moving the model is then a
-- single CFrame write on the Root (model.PrimaryPart.CFrame = ...), which is far cheaper
-- than PivotTo on a model with hundreds of parts, and only one part replicates.
function Models.Rig(model: Model): BasePart
	Models.Weld(model)
	local root = model.PrimaryPart :: BasePart
	root.Anchored = true
	return root
end

-- turn off shadows on every part (big savings for detailed models on display)
function Models.NoShadows(model: Instance)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CastShadow = false
		end
	end
end

return Models
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
-- Player save data in a DataStore, with retries, autosave and shutdown saving.
-- In Studio without "Enable Studio Access to API Services", the game still runs and
-- simply doesn't save.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = {}

export type Data = {
	coins: number,
	owned: { string },
	equipped: string,
	load: number,
	pile: number,
	spins: number,
	lastFreeSpinDay: number,
	daily: { lastDay: number, streak: number },
	boosts: { sell: number, capacity: number },
	auto: boolean,
	totalSold: number,
	tutorial: number, -- 1..5 = current tutorial step, 0 = finished
}

local function defaults(): Data
	return {
		coins = 0,
		owned = { "hands" },
		equipped = "hands",
		load = 0,
		pile = 0,
		spins = 0,
		lastFreeSpinDay = -1,
		daily = { lastDay = -1, streak = 0 },
		boosts = { sell = 0, capacity = 0 },
		auto = false,
		totalSold = 0,
		tutorial = 1,
	}
end

local store: DataStore? = nil
local ok, err = pcall(function()
	store = DataStoreService:GetDataStore("ClearTheSnow_v1")
end)
if not ok then
	warn("[ClearTheSnow] DataStore unavailable, progress will not save:", err)
end

local sessions: { [Player]: Data } = {}
local loaded: { [Player]: boolean } = {}

local function key(player: Player): string
	return "player_" .. player.UserId
end

local function merge(saved: any): Data
	local d = defaults()
	if typeof(saved) ~= "table" then
		return d
	end
	for k, v in saved do
		if (d :: any)[k] ~= nil and typeof(v) == typeof((d :: any)[k]) then
			(d :: any)[k] = v
		end
	end
	d.daily = {
		lastDay = if typeof(saved.daily) == "table" and typeof(saved.daily.lastDay) == "number" then saved.daily.lastDay else -1,
		streak = if typeof(saved.daily) == "table" and typeof(saved.daily.streak) == "number" then saved.daily.streak else 0,
	}
	d.boosts = {
		sell = if typeof(saved.boosts) == "table" and typeof(saved.boosts.sell) == "number" then saved.boosts.sell else 0,
		capacity = if typeof(saved.boosts) == "table" and typeof(saved.boosts.capacity) == "number" then saved.boosts.capacity else 0,
	}
	if not table.find(d.owned, "hands") then
		table.insert(d.owned, 1, "hands")
	end
	return d
end

function DataService.Load(player: Player): Data
	local data: Data? = nil
	if store then
		for attempt = 1, 3 do
			local success, result = pcall(function()
				return (store :: DataStore):GetAsync(key(player))
			end)
			if success then
				data = merge(result)
				loaded[player] = true
				break
			end
			warn("[ClearTheSnow] load failed (attempt " .. attempt .. "):", result)
			task.wait(1.5 * attempt)
		end
	end
	local d = data or defaults()
	sessions[player] = d
	return d
end

function DataService.Get(player: Player): Data?
	return sessions[player]
end

function DataService.Save(player: Player)
	local d = sessions[player]
	-- only write if the load succeeded, so a failed load never wipes real progress
	if not d or not store or not loaded[player] then
		return
	end
	for attempt = 1, 3 do
		local success, e = pcall(function()
			(store :: DataStore):SetAsync(key(player), d)
		end)
		if success then
			return
		end
		warn("[ClearTheSnow] save failed (attempt " .. attempt .. "):", e)
		task.wait(1.5 * attempt)
	end
end

function DataService.Release(player: Player)
	DataService.Save(player)
	sessions[player] = nil
	loaded[player] = nil
end

-- autosave
task.spawn(function()
	while true do
		task.wait(90)
		for _, player in Players:GetPlayers() do
			task.spawn(DataService.Save, player)
		end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() and not store then
		return
	end
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			DataService.Save(player)
			pending -= 1
		end)
	end
	local t = os.clock()
	while pending > 0 and os.clock() - t < 25 do
		task.wait(0.2)
	end
end)

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Timed events. Every Config.Events.Interval seconds this picks a random event from the
-- modules in the Events folder and runs it. The current state goes into attributes on
-- ReplicatedStorage.EventState, which the top-of-screen event bar reads.
--
-- To add an event, add a ModuleScript to src/server/Events that returns:
--   {
--     Name = "My Event",            -- shown at the top of the screen
--     BarKind = "progress" | "hp",  -- green progress bar or red HP bar
--     Weight = 1,                   -- optional: relative chance of being picked
--     Duration = 300,               -- seconds before it times out
--     Run = function(ev) ... return true end, -- true = players won
--   }
-- `ev` gives you helpers: ev.SetBar, ev.Announce, ev.Contribute, ev.TimeLeft, ev.AddZone,
-- ev.OnSnowballHit, ev.AllowSnowballsForAll, ev.OnCleanup, ev.Billboard, plus
-- ev.Config, ev.Models and ev.Snow (SnowService). See SantaSled.luau and Yeti.luau.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Models = require(Shared.Models)
local E = Config.Events

local EventService = {}

local stale = ReplicatedStorage:FindFirstChild("EventState") -- left by an old copy of the scripts
if stale then
	stale:Destroy()
end
local state = Instance.new("Folder")
state.Name = "EventState"
state.Parent = ReplicatedStorage

local zones = {}
local hitHandlers = {}
local snowballsForAll = false

-- ---------------------------------------------------------------- hooks used by Main / SnowballService
-- an event clear-zone containing this point, if any: { boost = n, onCleared = fn(player, amount) }
function EventService.ZoneAt(x: number, z: number)
	for _, zn in zones do
		local r = zn.rect
		if x >= r[1] and x <= r[3] and z >= r[2] and z <= r[4] then
			return zn
		end
	end
	return nil
end

-- returns true if an event used the hit
function EventService.HandleSnowballHit(inst: Instance, thrower: Player): boolean
	for _, fn in hitHandlers do
		if fn(inst, thrower) then
			return true
		end
	end
	return false
end

function EventService.SnowballsForAll(): boolean
	return snowballsForAll
end

-- ---------------------------------------------------------------- helpers
local function now(): number
	return Workspace:GetServerTimeNow()
end

local function billboard(part: BasePart, title: string, sub: string?, height: number?)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(260, 64)
	bb.StudsOffsetWorldSpace = Vector3.new(0, height or 6, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 400
	local function line(text, y, h, color)
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(0, y)
		t.Size = UDim2.fromScale(1, h)
		t.Font = Enum.Font.FredokaOne
		t.TextScaled = true
		t.Text = text
		t.TextColor3 = color
		t.TextStrokeTransparency = 0.2
		t.Parent = bb
	end
	line(title, 0, if sub then 0.6 else 1, Color3.fromHex("#ffd54f"))
	if sub then
		line(sub, 0.6, 0.4, Color3.new(1, 1, 1))
	end
	bb.Parent = part
	return bb
end

local function loadEvents()
	local list = {}
	local folder = script.Parent:WaitForChild("Events")
	for _, m in folder:GetChildren() do
		if m:IsA("ModuleScript") then
			local ok, ev = pcall(require, m)
			if ok and type(ev) == "table" and type(ev.Run) == "function" then
				ev.Id = m.Name
				table.insert(list, ev)
			else
				warn("[ClearTheSnow] event " .. m.Name .. " failed to load:", ev)
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Id < b.Id
	end)
	return list
end

local function pick(list)
	if E.OnlyEvent then
		for _, ev in list do
			if ev.Id == E.OnlyEvent then
				return ev
			end
		end
	end
	local total = 0
	for _, ev in list do
		total += ev.Weight or 1
	end
	local roll = math.random() * total
	for _, ev in list do
		roll -= ev.Weight or 1
		if roll <= 0 then
			return ev
		end
	end
	return list[1]
end

-- ---------------------------------------------------------------- running an event
local function run(def, hooks)
	local contributions: { [Player]: number } = {}
	local cleanups = {}
	local endsAt = now() + (def.Duration or 300)

	state:SetAttribute("Title", def.Name)
	state:SetAttribute("BarKind", def.BarKind or "progress")
	state:SetAttribute("Progress", if def.BarKind == "hp" then 1 else 0)
	state:SetAttribute("BarText", "")
	state:SetAttribute("EndsAt", endsAt)
	state:SetAttribute("Phase", "active")

	local ev = {
		Config = Config,
		Models = Models,
		Snow = hooks.SnowService,
		Billboard = billboard,
	}
	function ev.TimeLeft(): number
		return endsAt - now()
	end
	function ev.SetBar(fraction: number, text: string)
		state:SetAttribute("Progress", math.clamp(fraction, 0, 1))
		state:SetAttribute("BarText", text)
	end
	function ev.Announce(text: string, secs: number?)
		hooks.Notify:FireAllClients("toast", text, secs or 4)
	end
	function ev.Contribute(player: Player, amount: number)
		contributions[player] = (contributions[player] or 0) + amount
	end
	function ev.OnCleanup(fn)
		table.insert(cleanups, fn)
	end
	-- players scooping inside rect clear snow `boost` times faster without filling their load
	function ev.AddZone(rect: { number }, boost: number, onCleared)
		table.insert(zones, { rect = rect, boost = boost, onCleared = onCleared })
	end
	-- fn(hitInstance, thrower) -> true if the hit counted for this event
	function ev.OnSnowballHit(fn)
		table.insert(hitHandlers, fn)
	end
	function ev.AllowSnowballsForAll(on: boolean)
		snowballsForAll = on
		state:SetAttribute("SnowballsForAll", on)
	end

	local ok, result = pcall(def.Run, ev)
	if not ok then
		warn("[ClearTheSnow] event " .. tostring(def.Id) .. " errored:", result)
		result = false
	end
	for _, fn in cleanups do
		pcall(fn)
	end
	table.clear(zones)
	table.clear(hitHandlers)
	ev.AllowSnowballsForAll(false)

	if result == true then
		for player, amount in contributions do
			if player.Parent and amount > 0 then
				local coins = hooks.reward(player)
				hooks.Notify:FireClient(player, "toast", def.Name .. " complete! You earned " .. Config.FormatNumber(coins) .. " coins for helping.", 4)
			end
		end
	end
end

function EventService.Init(hooks)
	-- hooks: { Notify = RemoteEvent, SnowService = module, reward = fn(player) -> coins }
	local list = loadEvents()
	if #list == 0 then
		return
	end
	local interval = if RunService:IsStudio() then E.StudioInterval else E.Interval
	task.spawn(function()
		while true do
			state:SetAttribute("Phase", "waiting")
			state:SetAttribute("NextAt", now() + interval)
			task.wait(interval)
			if #Players:GetPlayers() > 0 then
				run(pick(list), hooks)
			end
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">Events</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">SantaSled</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Santa Sled Party: a stretch of the main road fills with deep snow that won't grow back
-- by itself. Players clear it so Santa's sleigh can take off. Settings: Config.Events.SantaSled.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local Event = {
	Name = "Santa Sled Party",
	BarKind = "progress",
	Weight = 1,
	Duration = Config.Events.SantaSled.Duration,
}

local function pole(parent: Instance, pos: Vector3)
	-- a red and white striped marker pole
	for i = 0, 5 do
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Size = Vector3.new(0.6, 1, 0.6)
		p.Material = Enum.Material.SmoothPlastic
		p.Color = if i % 2 == 0 then Color3.fromHex("#d32f2f") else Color3.new(1, 1, 1)
		p.CFrame = CFrame.new(pos + Vector3.new(0, 0.5 + i, 0))
		p.Parent = parent
	end
	local top = Instance.new("Part")
	top.Shape = Enum.PartType.Ball
	top.Anchored = true
	top.CanCollide = false
	top.CanQuery = false
	top.Material = Enum.Material.Neon
	top.Color = Color3.fromHex("#ffd54f")
	top.Size = Vector3.new(1, 1, 1)
	top.CFrame = CFrame.new(pos + Vector3.new(0, 6.4, 0))
	top.Parent = parent
end

function Event.Run(ev)
	local cfg = ev.Config.Events.SantaSled
	local r = cfg.Runway
	local tiles = ev.Snow.TilesInRect(r)

	-- deep snow on the runway, scaled to how many players there are
	local per = math.clamp(cfg.SnowPerPlayer * #Players:GetPlayers(), cfg.SnowPerPlayer, ev.Config.TILE_MAX_UNITS)
	ev.Snow.SetFrozen(tiles, true)
	ev.Snow.Fill(tiles, per)
	ev.OnCleanup(function()
		ev.Snow.SetFrozen(tiles, false)
	end)
	local start = math.max(1, ev.Snow.Amount(tiles))

	local folder = Instance.new("Folder")
	folder.Name = "SantaSledEvent"
	folder.Parent = Workspace
	ev.OnCleanup(function()
		folder:Destroy()
	end)
	for _, x in { r[1], r[3] } do
		for _, z in { r[2], r[4] } do
			pole(folder, Vector3.new(x, 0, z))
		end
	end
	local sign = Instance.new("Part")
	sign.Anchored, sign.CanCollide, sign.CanQuery, sign.Transparency = true, false, false, 1
	sign.Size = Vector3.new(1, 1, 1)
	sign.CFrame = CFrame.new((r[1] + r[3]) / 2, 4, (r[2] + r[4]) / 2)
	sign.Parent = folder
	ev.Billboard(sign, "SANTA'S RUNWAY", "Scoop the road clear!", 4)

	local sleigh = ev.Models.BuildSleigh()
	local base = CFrame.lookAt(cfg.SleighPosition, cfg.SleighPosition + Vector3.xAxis)
	sleigh:PivotTo(base)
	local root = ev.Models.Rig(sleigh) -- move it by its Root only
	sleigh.Parent = folder
	ev.Billboard(sleigh.PrimaryPart, "SANTA", "Waiting for a clear road", 9)

	ev.AddZone(r, cfg.ClearBoost, function(player, amount)
		ev.Contribute(player, amount)
	end)
	ev.Announce("Santa Sled Party! Clear the snow off the main road so Santa's sleigh can take off!", 5)

	local won = false
	while true do
		local progress = 1 - ev.Snow.Amount(tiles) / start
		local shown = math.clamp(progress / cfg.DoneAt, 0, 1)
		ev.SetBar(shown, "Road cleared: " .. math.floor(shown * 100) .. "%")
		if progress >= cfg.DoneAt then
			won = true
			break
		end
		if ev.TimeLeft() <= 0 then
			break
		end
		-- reindeer get restless
		root.CFrame = base * CFrame.new(0, math.abs(math.sin(os.clock() * 3)) * 0.15, 0)
		task.wait(0.2)
	end

	if not won then
		ev.SetBar(0, "Out of time!")
		ev.Announce("Out of time! Santa's sleigh is stuck in the snow. Maybe next time.", 5)
		task.wait(3)
		return false
	end

	-- take off down the runway and up into the sky
	ev.SetBar(1, "Ho ho ho! Santa is taking off!")
	ev.Announce("You did it! Santa's sleigh is taking off!", 4)
	local trail = Instance.new("Sparkles")
	trail.SparkleColor = Color3.fromHex("#ffe9a8")
	trail.Parent = sleigh.PrimaryPart
	local t0 = os.clock()
	while true do
		local t = os.clock() - t0
		if t > 8 then
			break
		end
		local x = 4 * t + 3 * t * t
		local y = math.max(0, t - 1.2) ^ 2 * 2.2
		local pitch = math.clamp((t - 1.2) * 0.12, 0, 0.35)
		root.CFrame = base * CFrame.new(0, y, -x) * CFrame.Angles(pitch, 0, 0)
		RunService.Heartbeat:Wait()
	end
	return true
end

return Event
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Yeti</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Yeti Abomination: a huge Yeti stomps onto the main road. Everyone can throw snowballs
-- (Q) during this event, whatever tool they hold. Its HP is Config.Events.Yeti.HitsPerPlayer
-- snowballs for every player in the server.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local Event = {
	Name = "Yeti Abomination",
	BarKind = "hp",
	Weight = 1,
	Duration = Config.Events.Yeti.Duration,
}

function Event.Run(ev)
	local cfg = ev.Config.Events.Yeti
	local maxHp = cfg.HitsPerPlayer * math.max(1, #Players:GetPlayers())
	local hp = maxHp

	-- more players joining makes it tougher
	local joined = Players.PlayerAdded:Connect(function()
		maxHp += cfg.HitsPerPlayer
		hp += cfg.HitsPerPlayer
	end)
	ev.OnCleanup(function()
		joined:Disconnect()
	end)

	local yeti = ev.Models.BuildYeti()
	local root = ev.Models.Rig(yeti) -- move it by its Root only
	for _, p in yeti:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			p.CanQuery = true -- snowballs can hit it
			p.CanCollide = true
		end
	end
	local pos = cfg.Position
	local facing = CFrame.lookAt(pos, Vector3.new(0, 0, 0) * Vector3.new(1, 0, 1) + Vector3.new(0, pos.Y, 0))
	root.CFrame = facing * CFrame.new(0, -14, 0)
	yeti.Parent = Workspace
	ev.OnCleanup(function()
		yeti:Destroy()
	end)
	ev.Billboard(yeti.PrimaryPart, "YETI", "Throw snowballs! (Q)", 17)

	local flinch = 0
	ev.AllowSnowballsForAll(true)
	ev.OnSnowballHit(function(inst, thrower)
		if hp > 0 and inst:IsDescendantOf(yeti) then
			hp -= 1
			flinch = 1
			ev.Contribute(thrower, 1)
			return true
		end
		return false
	end)
	ev.Announce("A Yeti Abomination is on the main road! Everyone can throw snowballs (Q). Knock it out!", 5)

	-- rise out of the snow
	for i = 1, 30 do
		root.CFrame = facing * CFrame.new(0, -14 + 14 * (i / 30), 0)
		task.wait(1 / 30)
	end

	local won = false
	local yaw = 0
	while true do
		local dt = RunService.Heartbeat:Wait()
		ev.SetBar(hp / maxHp, "Yeti HP: " .. math.max(0, hp) .. " / " .. maxHp)
		if hp <= 0 then
			won = true
			break
		end
		if ev.TimeLeft() <= 0 then
			break
		end
		-- turn toward the nearest player
		local best, bestD = nil, math.huge
		for _, p in Players:GetPlayers() do
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local d = (hrp.Position - pos).Magnitude
				if d < bestD then
					best, bestD = hrp, d
				end
			end
		end
		if best then
			local to = best.Position - pos
			local want = math.atan2(-to.X, -to.Z)
			local base = select(2, facing:ToOrientation())
			local diff = (want - base - yaw + math.pi) % (2 * math.pi) - math.pi
			yaw += diff * math.min(1, dt * 1.5)
		end
		flinch = math.max(0, flinch - dt * 5)
		local stomp = math.abs(math.sin(os.clock() * 2)) * 0.5
		root.CFrame = facing * CFrame.Angles(0, yaw, 0) * CFrame.new(0, stomp, 0) * CFrame.Angles(-0.15 * flinch, 0, 0)
	end

	local finalCf = root.CFrame
	if won then
		ev.SetBar(0, "The Yeti is down!")
		ev.Announce("The Yeti is knocked out! Great throwing, everyone!", 4)
		for i = 1, 40 do
			root.CFrame = finalCf * CFrame.Angles(-math.rad(85) * (i / 40), 0, 0)
			task.wait(1 / 30)
		end
		task.wait(1.5)
		finalCf = root.CFrame
	else
		ev.Announce("The Yeti got away! It'll be back...", 4)
	end
	for i = 1, 45 do
		root.CFrame = finalCf * CFrame.new(0, -0.35 * i, 0)
		task.wait(1 / 30)
	end
	return won
end

return Event
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Clear the Snow: server entry point.
-- Builds the town, runs the snow harvesting loop, handles selling, buying,
-- equipping, daily rewards and the spin wheel, and keeps player attributes in sync
-- for the client UI.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Models = require(Shared.Models)
local World = require(script.Parent.World)
local SnowService = require(script.Parent.SnowService)
local DataService = require(script.Parent.DataService)
local SnowballService = require(script.Parent.SnowballService)
local PresentService = require(script.Parent.PresentService)
local EventService = require(script.Parent.EventService)

local H = Config.Hub

-- ------------------------------------------------------------------ guard against old copies
-- If the place still holds an older copy of this game's server script, stop it and remove
-- anything it already built, so only this copy runs. Output says where the old one was.
for _, root in { game:GetService("ServerScriptService"), workspace, game:GetService("ServerStorage") } do
	for _, d in root:GetDescendants() do
		if d:IsA("Script") and not d:IsA("LocalScript") and d ~= script and d.Name == "Main" and not d:IsDescendantOf(script.Parent) then
			warn("[ClearTheSnow] Stopped an old copy of the server script at " .. d:GetFullName() .. ". Delete it in Studio so only Rojo's copy is left.")
			d.Enabled = false
			d:Destroy()
		end
	end
end
for _, name in { "Town", "Snow", "Presents", "SantaSledEvent" } do
	local old = workspace:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end
for _, name in { "Remotes" } do
	local old = ReplicatedStorage:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end
ReplicatedStorage:SetAttribute("ClearTheSnowVersion", Config.Version)

-- ------------------------------------------------------------------ remotes
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remoteEvent(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local function remoteFunction(name: string): RemoteFunction
	local r = Instance.new("RemoteFunction")
	r.Name = name
	r.Parent = remotes
	return r
end
local SetScooping = remoteEvent("SetScooping")
local SetAuto = remoteEvent("SetAuto")
local Notify = remoteEvent("Notify")
local BuyTool = remoteFunction("BuyTool")
local EquipTool = remoteFunction("EquipTool")
local ClaimDaily = remoteFunction("ClaimDaily")
local Spin = remoteFunction("Spin")
local SellPile = remoteFunction("SellPile")
local TutorialAction = remoteEvent("TutorialAction")

-- ------------------------------------------------------------------ world
local blocks, hub = World.Build()
SnowService.Init(blocks)

-- ------------------------------------------------------------------ helpers
local function today(): number
	return math.floor(os.time() / 86400)
end

local function owns(d, id: string): boolean
	return table.find(d.owned, id) ~= nil
end

local function nextTool(d)
	for _, t in Config.Tools do
		if not owns(d, t.id) then
			return t
		end
	end
	return nil
end

-- progress-scaled coin unit used by daily rewards and the wheel
local function progressCoins(d): number
	local n = nextTool(d)
	return if n then n.price else Config.Tools[#Config.Tools].price * 1.5
end

local function boostActive(d, name: string): boolean
	return (d.boosts[name] or 0) > os.time()
end

local function capacity(d): number
	return Config.GetTool(d.equipped).capacity * (if boostActive(d, "capacity") then 2 else 1)
end

local function dailyStatus(d)
	local t = today()
	local canClaim = d.daily.lastDay < t
	local continuing = d.daily.lastDay == t - 1
	local nextStreak = if canClaim then (if continuing then d.daily.streak + 1 else 1) else d.daily.streak
	local idx = (math.max(1, nextStreak) - 1) % #Config.DailyRewards + 1
	return canClaim, idx, nextStreak
end

local function dailyReward(d, idx: number)
	local r = Config.DailyRewards[idx]
	return math.max(r.min, math.floor(progressCoins(d) * r.pct + 0.5)), r.spins
end

local function freeSpinAvailable(d): boolean
	return d.lastFreeSpinDay < today()
end

local function wheelCoins(d, seg): number
	return math.max(10, math.floor(progressCoins(d) * 0.1 + 0.5)) * seg.mult
end

-- ------------------------------------------------------------------ tutorial
-- Steps (see Config.Tutorial): 1 scoop until full, 2 toss on the pile, 3 sell,
-- 4 buy the next tool, 5 "enjoy the game" card, 0 finished.
local publish -- forward declaration

local function setTutorial(player: Player, d, step: number)
	if d.tutorial == step then
		return
	end
	if step == 4 and not nextTool(d) then
		step = 5 -- nothing left to buy
	end
	d.tutorial = step
	if step == 5 then
		task.delay(Config.Tutorial.EnjoySeconds, function()
			local d2 = DataService.Get(player)
			if d2 and d2.tutorial == 5 then
				d2.tutorial = 0
				publish(player)
				task.spawn(DataService.Save, player)
			end
		end)
	end
end

-- automatic steps, checked every frame
local function tutorialTick(player: Player, d, cap: number)
	local t = d.tutorial
	if t == 1 and d.load >= math.max(1, cap) - 1e-6 then
		setTutorial(player, d, 2)
		t = 2
	end
	if (t == 1 or t == 2) and d.pile >= 1 then
		setTutorial(player, d, 3)
	end
end

-- ------------------------------------------------------------------ per-player runtime
type Runtime = {
	scooping: boolean,
	visual: Instance?, -- a Tool for hand tools, a welded Model for machines
	tool: Tool?,
	loadPart: BasePart?,
	loadFull: number,
	loadSize: Vector3?,
	minFill: number,
	front: number,
	tilt: number,
	dig: number,
	swing: number,
	sitTrack: AnimationTrack?,
	origHip: number?,
	lastPublish: number,
	fullWarned: boolean,
	busy: boolean,
}
local runtime: { [Player]: Runtime } = {}

-- ------------------------------------------------------------------ snowballs and presents
SnowballService.Init(remotes, {
	-- only with Bare Hands equipped
	canThrow = function(player)
		local d = DataService.Get(player)
		return d ~= nil and (d.equipped == "hands" or EventService.SnowballsForAll())
	end,
	onStun = function(player)
		local r = runtime[player]
		if r then
			r.scooping = false
		end
	end,
	onHit = function(inst, thrower)
		return EventService.HandleSnowballHit(inst, thrower)
	end,
	walkSpeed = function(player)
		local d = DataService.Get(player)
		return Config.GetTool(if d then d.equipped else "hands").speed
	end,
})
PresentService.Init(Notify, function(player)
	-- coins for picking up a present: scales with your next upgrade
	local d = DataService.Get(player)
	if not d then
		return 0
	end
	local coins = math.max(Config.Presents.MinCoins, math.floor(progressCoins(d) * Config.Presents.ProgressShare + 0.5))
	d.coins += coins
	publish(player)
	return coins
end)
EventService.Init({
	Notify = Notify,
	SnowService = SnowService,
	-- coins for helping with an event that succeeded
	reward = function(player)
		local d = DataService.Get(player)
		if not d then
			return 0
		end
		local coins = math.max(Config.Events.RewardMin, math.floor(progressCoins(d) * Config.Events.RewardShare + 0.5))
		d.coins += coins
		publish(player)
		return coins
	end,
})
remotes.Parent = ReplicatedStorage

function publish(player: Player)
	local d = DataService.Get(player)
	if not d then
		return
	end
	local canClaim, idx, streak = dailyStatus(d)
	player:SetAttribute("Coins", math.floor(d.coins))
	player:SetAttribute("Load", math.floor(d.load + 1e-6))
	player:SetAttribute("Capacity", capacity(d))
	player:SetAttribute("Pile", math.floor(d.pile))
	player:SetAttribute("Equipped", d.equipped)
	player:SetAttribute("Owned", table.concat(d.owned, ","))
	player:SetAttribute("Spins", d.spins + (if freeSpinAvailable(d) then 1 else 0))
	player:SetAttribute("FreeSpin", freeSpinAvailable(d))
	player:SetAttribute("DailyCanClaim", canClaim)
	player:SetAttribute("DailyIndex", idx)
	player:SetAttribute("DailyStreak", if canClaim then streak - 1 else streak)
	player:SetAttribute("DailyBroken", canClaim and d.daily.lastDay >= 0 and d.daily.lastDay < today() - 1 and d.daily.streak > 0)
	player:SetAttribute("ProgressCoins", progressCoins(d))
	player:SetAttribute("BoostSell", d.boosts.sell or 0)
	player:SetAttribute("BoostCapacity", d.boosts.capacity or 0)
	player:SetAttribute("Auto", d.auto)
	player:SetAttribute("Tutorial", d.tutorial)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Coins.Value = math.floor(d.coins)
		ls.Sold.Value = math.floor(d.totalSold)
	end
end

-- ------------------------------------------------------------------ equipping visuals
local SIT_R15 = "rbxassetid://2506281703"
local SIT_R6 = "rbxassetid://178130996"

local function clearVisual(player: Player, r: Runtime)
	if r.sitTrack then
		r.sitTrack:Stop(0.2)
		r.sitTrack = nil
	end
	if r.visual then
		r.visual:Destroy()
		r.visual = nil
	end
	r.tool = nil
	r.loadPart = nil
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and r.origHip then
		hum.HipHeight = r.origHip
	end
end

local function attachVisual(player: Player)
	local r = runtime[player]
	local d = DataService.Get(player)
	if not r or not d then
		return
	end
	clearVisual(player, r)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not (char and hum and hrp) or hum.Health <= 0 then
		return
	end
	if not r.origHip then
		r.origHip = hum.HipHeight
	end
	local isR15 = hum.RigType == Enum.HumanoidRigType.R15
	local groundToHrp = (r.origHip :: number) + hrp.Size.Y / 2 + (if isR15 then 0 else 2)
	local tool = Config.GetTool(d.equipped)
	hum.WalkSpeed = tool.speed

	local model = Models.Build(tool.id)
	local minZ = math.huge
	local minY = math.huge
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			minZ = math.min(minZ, p.Position.Z - p.Size.Z / 2)
			minY = math.min(minY, p.Position.Y - p.Size.Y / 2)
		end
	end
	local loadPart = model:FindFirstChild("Load", true) :: BasePart?
	Models.Weld(model)
	model.Name = "EquippedTool"

	r.loadPart = loadPart
	r.loadFull = if loadPart then (loadPart:GetAttribute("FullHeight") or loadPart.Size.Y) else 1
	r.loadSize = if loadPart then loadPart.Size else nil
	r.minFill = if tool.id == "hands" then 0.45 else 0

	if tool.kind == "hand" then
		-- Hand tools become a real Roblox Tool, so the character holds it out in the
		-- right hand with the standard hold pose. The model's Root part is the Handle.
		local len = -minY -- shaft + blade length below the grip, in studs
		r.tilt = if len > 3.4 then math.acos(math.clamp(3.4 / len, -1, 0.99)) else 0.35
		r.front = 1.5 + tool.radius * 0.6
		local t = Instance.new("Tool")
		t.Name = tool.name
		t.ToolTip = tool.name
		t.CanBeDropped = false
		t.RequiresHandle = true
		t.ManualActivationOnly = true
		local handle = model.PrimaryPart :: BasePart
		handle.Name = "Handle"
		for _, c in model:GetChildren() do
			c.Parent = t
		end
		model:Destroy()
		t.Grip = CFrame.Angles(-r.tilt, 0, 0)
		t.Parent = char -- parenting a Tool to the character equips it
		-- keep it in hand if anything tries to unequip it
		t.AncestryChanged:Connect(function()
			if r.visual == t and t.Parent and t.Parent ~= char and char.Parent then
				task.defer(function()
					if r.visual == t and char.Parent then
						t.Parent = char
					end
				end)
			end
		end)
		r.visual = t
		r.tool = t
	else
		local weld = Instance.new("Weld")
		local seat = model:GetAttribute("SeatOffset") :: Vector3
		local standing = model:GetAttribute("Standing") == true
		local hrpHeight = groundToHrp
		if not standing then
			hrpHeight = seat.Y + 0.6
			hum.HipHeight = (r.origHip :: number) + (hrpHeight - groundToHrp)
			local anim = Instance.new("Animation")
			anim.AnimationId = if isR15 then SIT_R15 else SIT_R6
			local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
			local ok, track = pcall(function()
				return animator:LoadAnimation(anim)
			end)
			if ok and track then
				track.Priority = Enum.AnimationPriority.Action
				track.Looped = true
				track:Play(0.2)
				r.sitTrack = track
			end
		end
		weld.Part0 = hrp
		weld.C0 = CFrame.new(-seat.X, -hrpHeight, -seat.Z)
		r.front = math.max(2, seat.Z - minZ - tool.radius * 0.5)
		weld.Part1 = model.PrimaryPart
		weld.Parent = model.PrimaryPart
		model.Parent = char
		r.visual = model
	end
	r.dig = 0
	r.swing = -1
end

local function updateLoadVisual(r: Runtime, fill: number)
	local p = r.loadPart
	if not p or not p.Parent then
		return
	end
	if r.minFill > 0 and r.loadSize then
		-- bare hands: always hold a little snowball that grows as you scoop
		local k = r.minFill + (1 - r.minFill) * math.clamp(fill, 0, 1)
		local want = r.loadSize * k
		if (p.Size - want).Magnitude > 0.02 then
			p.Size = want
		end
		p.Transparency = 0
	elseif fill < 0.02 then
		p.Transparency = 1
	else
		p.Transparency = 0
		local s = p.Size
		local y = math.max(0.05, r.loadFull * fill)
		if math.abs(s.Y - y) > 0.03 then
			p.Size = Vector3.new(s.X, y, s.Z)
		end
	end
end

local function equip(player: Player, id: string)
	local d = DataService.Get(player)
	if not d or not owns(d, id) then
		return false
	end
	d.equipped = id
	d.load = math.min(d.load, capacity(d))
	attachVisual(player)
	publish(player)
	return true
end

-- ------------------------------------------------------------------ actions
local function sell(player: Player)
	local d = DataService.Get(player)
	if not d then
		return 0
	end
	if d.pile < 1 then
		Notify:FireClient(player, "toast", if d.load > 0 then "Toss your snow on the Snow Pile first!" else "Your pile is empty. Go clear some snow!")
		return 0
	end
	local units = math.floor(d.pile)
	local coins = units * Config.SNOW_VALUE * (if boostActive(d, "sell") then 2 else 1)
	d.coins += coins
	d.totalSold += units
	d.pile -= units
	if d.tutorial >= 1 and d.tutorial <= 3 then
		local n = nextTool(d)
		if Config.Tutorial.StarterBonus and n and Config.ToolIndex[n.id] == 2 and d.coins < n.price then
			local bonus = n.price - d.coins
			d.coins += bonus
			Notify:FireClient(player, "toast", "Starter bonus: +" .. bonus .. " coins. Go buy the " .. n.name .. "!", 4)
		end
		setTutorial(player, d, 4)
	end
	publish(player)
	Notify:FireClient(player, "sold", coins)
	return coins
end

local function openFor(player: Player, panel: string, focus: string?)
	Notify:FireClient(player, "open", panel, focus)
end

hub.SellPrompt.Triggered:Connect(sell)
hub.ShopPrompt.Triggered:Connect(function(player)
	openFor(player, "shop")
end)
for _, disp in hub.Displays do
	disp.prompt.Triggered:Connect(function(player)
		openFor(player, "shop", disp.id)
	end)
	disp.click.MouseClick:Connect(function(player)
		openFor(player, "shop", disp.id)
	end)
end
hub.WheelPrompt.Triggered:Connect(function(player)
	openFor(player, "spin")
end)
hub.WheelClick.MouseClick:Connect(function(player)
	openFor(player, "spin")
end)
hub.GiftPrompt.Triggered:Connect(function(player)
	openFor(player, "daily")
end)
hub.GiftClick.MouseClick:Connect(function(player)
	openFor(player, "daily")
end)

SellPile.OnServerInvoke = function(player)
	-- selling from the UI only works while standing at the buyer
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or (hrp.Position - (H.Sell + Vector3.new(0, 0, 5))).Magnitude > 18 then
		return 0
	end
	return sell(player)
end

SetScooping.OnServerEvent:Connect(function(player, on)
	local r = runtime[player]
	if r then
		r.scooping = on == true
	end
end)

TutorialAction.OnServerEvent:Connect(function(player, action)
	local d = DataService.Get(player)
	if not d then
		return
	end
	if action == "skip" then
		d.tutorial = 0
	elseif action == "replay" then
		d.tutorial = 1
	end
	publish(player)
end)

SetAuto.OnServerEvent:Connect(function(player, on)
	local d = DataService.Get(player)
	if d then
		d.auto = on == true
		publish(player)
	end
end)

BuyTool.OnServerInvoke = function(player, id)
	local d = DataService.Get(player)
	local r = runtime[player]
	if not d or not r or typeof(id) ~= "string" or r.busy then
		return false, "Try again."
	end
	local i = Config.ToolIndex[id]
	if not i then
		return false, "Unknown tool."
	end
	local tool = Config.Tools[i]
	if owns(d, id) then
		equip(player, id)
		return true, "Equipped " .. tool.name
	end
	if i > 1 and not owns(d, Config.Tools[i - 1].id) then
		return false, "Buy the " .. Config.Tools[i - 1].name .. " first."
	end
	if d.coins < tool.price then
		return false, "You need " .. Config.FormatNumber(tool.price - d.coins) .. " more coins."
	end
	r.busy = true
	d.coins -= tool.price
	table.insert(d.owned, id)
	equip(player, id)
	r.busy = false
	if d.tutorial >= 1 and d.tutorial <= 4 then
		setTutorial(player, d, 5)
		publish(player)
	end
	task.spawn(DataService.Save, player)
	return true, "You got the " .. tool.name .. "!"
end

EquipTool.OnServerInvoke = function(player, id)
	if typeof(id) ~= "string" then
		return false
	end
	return equip(player, id)
end

ClaimDaily.OnServerInvoke = function(player)
	local d = DataService.Get(player)
	if not d then
		return nil
	end
	local canClaim, idx, streak = dailyStatus(d)
	if not canClaim then
		return nil
	end
	local coins, spins = dailyReward(d, idx)
	d.daily = { lastDay = today(), streak = streak }
	d.coins += coins
	d.spins += spins
	publish(player)
	task.spawn(DataService.Save, player)
	return { coins = coins, spins = spins, day = idx }
end

Spin.OnServerInvoke = function(player)
	local d = DataService.Get(player)
	local r = runtime[player]
	if not d or not r or r.busy then
		return nil
	end
	if freeSpinAvailable(d) then
		d.lastFreeSpinDay = today()
	elseif d.spins > 0 then
		d.spins -= 1
	else
		return nil
	end
	local total = 0
	for _, s in Config.Wheel do
		total += s.weight
	end
	local roll = math.random() * total
	local index = 1
	for i, s in Config.Wheel do
		roll -= s.weight
		if roll <= 0 then
			index = i
			break
		end
	end
	local seg = Config.Wheel[index]
	local msg
	if seg.kind == "coins" then
		local c = wheelCoins(d, seg)
		d.coins += c
		msg = "+" .. Config.FormatNumber(c) .. " coins!"
	elseif seg.kind == "spin" then
		d.spins += 1
		msg = "+1 bonus spin!"
	else
		local now = os.time()
		d.boosts[seg.boost] = math.max(now, d.boosts[seg.boost] or 0) + seg.mins * 60
		msg = (if seg.boost == "sell" then "2x sell price" else "2x carry capacity") .. " for " .. seg.mins .. " minutes!"
	end
	publish(player)
	task.spawn(DataService.Save, player)
	return { index = index, message = msg }
end

-- ------------------------------------------------------------------ players
local function onCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	char:WaitForChild("HumanoidRootPart", 10)
	if not hum then
		return
	end
	local r = runtime[player]
	if r then
		r.origHip = hum.HipHeight
		r.visual = nil
		r.sitTrack = nil
	end
	task.wait(0.2)
	attachVisual(player)
end

local function onPlayer(player: Player)
	runtime[player] = {
		scooping = false,
		loadFull = 1,
		minFill = 0,
		front = 2,
		tilt = 0,
		dig = 0,
		swing = -1,
		lastPublish = 0,
		fullWarned = false,
		busy = false,
	}
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = ls
	local sold = Instance.new("IntValue")
	sold.Name = "Sold"
	sold.Parent = ls
	ls.Parent = player

	local d = DataService.Load(player)
	if not player.Parent then
		DataService.Release(player)
		return
	end
	if not owns(d, d.equipped) then
		d.equipped = "hands"
	end
	publish(player)
	player:SetAttribute("Ready", true)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayer, p)
end
Players.PlayerRemoving:Connect(function(player)
	runtime[player] = nil
	DataService.Release(player)
end)

-- ------------------------------------------------------------------ main loop
local pileFlat = Vector3.new(H.Pile.X, 0, H.Pile.Z)
RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	for player, r in runtime do
		local d = DataService.Get(player)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not (d and hum and hrp) or hum.Health <= 0 then
			continue
		end
		local tool = Config.GetTool(d.equipped)
		local cap = capacity(d)
		local moving = hum.MoveDirection.Magnitude > 0.1
		local wants = r.scooping or d.auto or (tool.kind == "machine" and moving)
		local working = false
		local inZone = false
		if wants then
			local look = hrp.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
			local pos = hrp.Position + flat * r.front
			local zone = EventService.ZoneAt(pos.X, pos.Z)
			if zone then
				-- event clear-zone (e.g. Santa's runway): snow is shoveled aside, not carried
				inZone = true
				local got = SnowService.Harvest(pos.X, pos.Z, tool.radius, tool.rate * dt * zone.boost)
				if got > 0 then
					zone.onCleared(player, got)
					working = true
				end
			elseif d.load < cap - 1e-6 then
				local got = SnowService.Harvest(pos.X, pos.Z, tool.radius, math.min(tool.rate * dt, cap - d.load))
				if got > 0 then
					d.load = math.min(cap, d.load + got)
					working = true
				end
			end
		end
		if d.load >= cap - 1e-6 and not inZone then
			if wants and not r.fullWarned then
				r.fullWarned = true
				Notify:FireClient(player, "full")
			end
		else
			r.fullWarned = false
		end

		-- digging motion for hand tools
		if tool.kind == "hand" and r.tool then
			r.dig = if working then r.dig + dt * 9 else 0
			local swing = if working then (math.sin(r.dig) * 0.5 + 0.5) * 0.5 else 0
			if math.abs(swing - r.swing) > 0.04 then
				r.swing = swing
				r.tool.Grip = CFrame.Angles(-(r.tilt + swing), 0, 0)
			end
		end

		-- toss into the pile
		local flatPos = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
		local reach = H.PileRadius + 7 + (if tool.kind == "machine" then r.front * 0.6 else 0)
		if d.load >= 1 and (flatPos - pileFlat).Magnitude < reach then
			local units = math.floor(d.load + 1e-6)
			d.pile += units
			d.load -= units
			Notify:FireClient(player, "dumped", units)
			publish(player)
		end

		if d.tutorial > 0 then
			tutorialTick(player, d, cap)
		end
		updateLoadVisual(r, d.load / cap)
		if now - r.lastPublish > 0.15 then
			r.lastPublish = now
			publish(player)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">PresentService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Christmas presents that drop from the sky every now and then. Each one floats down
-- under a little parachute glow, lands somewhere in town, and the first player to walk
-- into it gets bonus coins. Tuning: Config.Presents.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Models = require(Shared.Models)
local P = Config.Presents

local PresentService = {}

local WRAPS = {
	{ "#c62828", "#ffd54f" },
	{ "#2e7d32", "#ffffff" },
	{ "#1565c0", "#e0e0e0" },
	{ "#8e24aa", "#ffd54f" },
	{ "#ef6c00", "#c62828" },
}

local folder: Folder
local live = {}
local rng = Random.new()

-- a spot on open ground (not a roof, not the market), or nil
local function findSpot(): Vector3?
	local half = Config.WORLD_SIZE / 2 * 0.85
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	for _ = 1, 15 do
		local x, z = rng:NextNumber(-half, half), rng:NextNumber(-half, half)
		local nearMarket = math.abs(x) < 45 and z > -40 and z < 15
		if not nearMarket then
			local hit = Workspace:Raycast(Vector3.new(x, 150, z), Vector3.new(0, -300, 0), params)
			if hit and hit.Position.Y < 2 and not (hit.Instance.Parent and hit.Instance.Parent:FindFirstChildOfClass("Humanoid")) then
				return hit.Position
			end
		end
	end
	return nil
end

local function spawnPresent(reward: (Player) -> number, notify: RemoteEvent)
	local spot = findSpot()
	if not spot then
		return
	end
	local gift = Models.BuildGift()
	local wrap = WRAPS[rng:NextInteger(1, #WRAPS)]
	for _, p in gift:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			p.Color = if p.Material == Enum.Material.Metal then Color3.fromHex(wrap[2]) else Color3.fromHex(wrap[1])
			p.CanCollide = false
			p.CanQuery = false
		end
	end
	gift.Name = "Present"
	-- glow so it can be spotted from a distance
	local light = Instance.new("PointLight")
	light.Color = Color3.fromHex("#ffe9a8")
	light.Range = 14
	light.Brightness = 2
	light.Parent = gift.PrimaryPart
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = Color3.fromHex("#fff3c4")
	sparkle.Parent = gift.PrimaryPart
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 30)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 5.5, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 160
	bb.LightInfluence = 0
	local tl = Instance.new("TextLabel")
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Font = Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.Text = "PRESENT"
	tl.TextColor3 = Color3.fromHex("#ffd54f")
	tl.TextStrokeTransparency = 0.2
	tl.Parent = bb
	bb.Parent = gift.PrimaryPart

	-- invisible pickup box
	local hitbox = Instance.new("Part")
	hitbox.Name = "Pickup"
	hitbox.CanCollide = false
	hitbox.CanQuery = false
	hitbox.Transparency = 1
	hitbox.Size = Vector3.new(6, 7, 6)
	hitbox.CFrame = CFrame.new(0, 3, 0)
	hitbox.Parent = gift
	local root = Models.Rig(gift) -- falls by moving just the Root
	hitbox.CanTouch = true

	local entry = { model = gift, hitbox = hitbox, target = spot, y = spot.Y + 120, spin = rng:NextNumber(0, 6), landedAt = nil, taken = false }
	local function place()
		root.CFrame = CFrame.new(spot.X, entry.y, spot.Z) * CFrame.Angles(0, entry.spin, 0)
	end
	place()
	entry.place = place
	gift.Parent = folder

	hitbox.Touched:Connect(function(other)
		if entry.taken then
			return
		end
		local player = Players:GetPlayerFromCharacter(other.Parent)
		local hum = other.Parent and other.Parent:FindFirstChildOfClass("Humanoid")
		if not player or not hum or hum.Health <= 0 then
			return
		end
		entry.taken = true
		local coins = reward(player)
		notify:FireClient(player, "present", coins)
		gift:Destroy()
	end)
	table.insert(live, entry)
end

function PresentService.Init(notify: RemoteEvent, reward: (Player) -> number)
	folder = Instance.new("Folder")
	folder.Name = "Presents"
	folder.Parent = Workspace

	-- falling and cleanup
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for i = #live, 1, -1 do
			local e = live[i]
			if e.taken or not e.model.Parent then
				table.remove(live, i)
			elseif not e.landedAt then
				e.y = math.max(e.target.Y, e.y - P.FallSpeed * dt)
				e.spin += dt * 1.2
				e.place()
				if e.y <= e.target.Y then
					e.landedAt = now
				end
			elseif now - e.landedAt > P.Lifetime then
				e.model:Destroy()
				table.remove(live, i)
			end
		end
	end)

	-- drops
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(P.Interval[1], P.Interval[2]))
			if #Players:GetPlayers() > 0 and #live < P.MaxOnMap then
				local n = math.min(rng:NextInteger(P.PerDrop[1], P.PerDrop[2]), P.MaxOnMap - #live)
				for _ = 1, n do
					spawnPresent(reward, notify)
				end
				notify:FireAllClients("toast", "Presents are falling from the sky! Grab them for bonus coins.", 3.5)
			end
		end
	end)
end

return PresentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">SnowService</string>
          <string name="Source"><![CDATA[--!strict
-- Harvestable snow that grows back. The town is split into square tiles; each tile
-- holds 0..TILE_MAX_UNITS units of snow and is drawn as one Snow-material part whose
-- height follows the amount of snow on it.

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local SnowService = {}

local SIZE = Config.WORLD_SIZE
local TILE = Config.TILE
local N = math.floor(SIZE / TILE)
local MAX = Config.TILE_MAX_UNITS
local UH = Config.UNIT_HEIGHT
local REGROW_RATE = MAX / Config.REGROW_SECONDS

local units: { number } = table.create(N * N, MAX)
local blocked: { boolean } = table.create(N * N, false)
local cooldown: { number } = table.create(N * N, 0)
local frozen: { boolean } = table.create(N * N, false) -- events can stop tiles regrowing
local parts: { [number]: BasePart } = {}
local dirty: { [number]: boolean } = {}
local folder: Folder

local function idx(i: number, j: number): number
	return j * N + i + 1
end
local function tileOf(x: number, z: number): (number, number)
	return math.floor((x + SIZE / 2) / TILE), math.floor((z + SIZE / 2) / TILE)
end
local function centre(i: number, j: number): (number, number)
	return -SIZE / 2 + (i + 0.5) * TILE, -SIZE / 2 + (j + 0.5) * TILE
end

local snowColors = {
	Color3.fromRGB(244, 248, 255),
	Color3.fromRGB(238, 244, 253),
	Color3.fromRGB(248, 250, 255),
}

-- Snow height is drawn in steps of DRAW_STEP studs, so a slowly regrowing tile only
-- updates (and replicates to every player) a few times instead of every second.
local DRAW_STEP = 0.25
local drawn: { number } = table.create(N * N, -1)

local function draw(k: number)
	local p = parts[k]
	if not p then
		return
	end
	local u = units[k]
	local h = u * UH
	local level = if u < 0.15 then 0 else math.max(1, math.floor(h / DRAW_STEP + 0.5))
	if level == drawn[k] then
		return
	end
	drawn[k] = level
	if level == 0 then
		p.Transparency = 1
		h = 0.05
	else
		p.Transparency = 0
		h = if u >= MAX - 0.01 then MAX * UH else level * DRAW_STEP
	end
	local j = (k - 1) // N
	local i = (k - 1) % N
	local x, z = centre(i, j)
	p.Size = Vector3.new(TILE, h + 0.2, TILE)
	p.CFrame = CFrame.new(x, h / 2 + 0.1, z)
end

-- rects: list of { x0, z0, x1, z1 } in studs where snow never grows
function SnowService.Init(rects: { { number } })
	for _, r in rects do
		local i0, j0 = tileOf(math.min(r[1], r[3]), math.min(r[2], r[4]))
		local i1, j1 = tileOf(math.max(r[1], r[3]) - 0.01, math.max(r[2], r[4]) - 0.01)
		for j = math.max(0, j0), math.min(N - 1, j1) do
			for i = math.max(0, i0), math.min(N - 1, i1) do
				local k = idx(i, j)
				blocked[k] = true
				units[k] = 0
			end
		end
	end
	folder = Instance.new("Folder")
	folder.Name = "Snow"
	local rng = Random.new(42)
	for j = 0, N - 1 do
		for i = 0, N - 1 do
			local k = idx(i, j)
			if not blocked[k] then
				local p = Instance.new("Part")
				p.Name = "SnowTile"
				p.Anchored = true
				p.CanCollide = false
				p.CanTouch = false
				p.CanQuery = false
				p.CastShadow = false
				p.Material = Enum.Material.Snow
				p.Color = snowColors[rng:NextInteger(1, #snowColors)]
				p.TopSurface = Enum.SurfaceType.Smooth
				p.BottomSurface = Enum.SurfaceType.Smooth
				parts[k] = p
				draw(k)
				p.Parent = folder
			end
		end
	end
	folder.Parent = workspace

	-- regrowth
	task.spawn(function()
		local step = 1
		while true do
			task.wait(step)
			for k = 1, N * N do
				if not blocked[k] and not frozen[k] and units[k] < MAX then
					if cooldown[k] > 0 then
						cooldown[k] -= step
					else
						units[k] = math.min(MAX, units[k] + REGROW_RATE * step * (0.6 + math.random() * 0.8))
						dirty[k] = true
					end
				end
			end
		end
	end)
	-- redraw changed tiles a few times per second
	task.spawn(function()
		while true do
			task.wait(0.1)
			for k in dirty do
				draw(k)
			end
			table.clear(dirty)
		end
	end)
end

-- Remove up to `amount` units from the tiles inside a circle. Returns units removed.
function SnowService.Harvest(x: number, z: number, radius: number, amount: number): number
	if amount <= 0 then
		return 0
	end
	local r = math.max(radius, TILE * 0.5)
	local i0, j0 = tileOf(x - r, z - r)
	local i1, j1 = tileOf(x + r, z + r)
	local list = {}
	local avail = 0
	local reach = (r + TILE * 0.5) ^ 2
	for j = math.max(0, j0), math.min(N - 1, j1) do
		for i = math.max(0, i0), math.min(N - 1, i1) do
			local k = idx(i, j)
			if not blocked[k] and units[k] > 0.001 then
				local cx, cz = centre(i, j)
				if (cx - x) ^ 2 + (cz - z) ^ 2 <= reach then
					table.insert(list, k)
					avail += units[k]
				end
			end
		end
	end
	if avail <= 0 then
		return 0
	end
	local take = math.min(amount, avail)
	local f = take / avail
	for _, k in list do
		units[k] -= units[k] * f
		if units[k] < 0.05 then
			units[k] = 0
		end
		cooldown[k] = Config.REGROW_DELAY[1] + math.random() * (Config.REGROW_DELAY[2] - Config.REGROW_DELAY[1])
		dirty[k] = true
	end
	return take
end

-- ---------------------------------------------------------------- helpers for events
-- tile ids inside a rectangle { x0, z0, x1, z1 } (studs), skipping tiles without snow
function SnowService.TilesInRect(r: { number }): { number }
	local list = {}
	local i0, j0 = tileOf(math.min(r[1], r[3]), math.min(r[2], r[4]))
	local i1, j1 = tileOf(math.max(r[1], r[3]) - 0.01, math.max(r[2], r[4]) - 0.01)
	for j = math.max(0, j0), math.min(N - 1, j1) do
		for i = math.max(0, i0), math.min(N - 1, i1) do
			local k = idx(i, j)
			if not blocked[k] then
				table.insert(list, k)
			end
		end
	end
	return list
end

-- stop (or restart) regrowth on these tiles
function SnowService.SetFrozen(list: { number }, on: boolean)
	for _, k in list do
		frozen[k] = on
		if not on then
			cooldown[k] = 0
		end
	end
end

-- set these tiles to an exact amount of snow (0..TILE_MAX_UNITS)
function SnowService.Fill(list: { number }, amount: number)
	for _, k in list do
		units[k] = math.clamp(amount, 0, MAX)
		dirty[k] = true
	end
end

-- total snow on these tiles
function SnowService.Amount(list: { number }): number
	local t = 0
	for _, k in list do
		t += units[k]
	end
	return t
end

function SnowService.DepthAt(x: number, z: number): number
	local i, j = tileOf(x, z)
	if i < 0 or j < 0 or i >= N or j >= N then
		return 0
	end
	return units[idx(i, j)] * UH
end

return SnowService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">SnowballService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Snowball fights. With Bare Hands equipped a player can throw snowballs. The server
-- flies each snowball itself (raycasting along its arc) and decides hits, so clients
-- can't fake them. Every client draws the snowball and the stumble. Tuning: Config.Snowball.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local SB = Config.Snowball

local SnowballService = {}

-- canThrow(player) -> boolean ; onStun(player, seconds) ; walkSpeed(player) -> number
-- onHit(instance, thrower) -> boolean (true = an event used the hit)
function SnowballService.Init(remotes: Folder, hooks)
	local throwRemote = Instance.new("RemoteEvent")
	throwRemote.Name = "ThrowSnowball"
	throwRemote.Parent = remotes
	local fx = Instance.new("RemoteEvent") -- to all clients: "throw" and "stun"
	fx.Name = "SnowballFx"
	fx.Parent = remotes

	local lastThrow: { [Player]: number } = {}
	local stunnedUntil: { [Player]: number } = {}
	local flying = {}

	local function stun(victim: Player, thrower: Player)
		local now = os.clock()
		if (stunnedUntil[victim] or 0) + SB.ImmuneSeconds > now then
			return -- still stunned or briefly immune, so nobody gets stun-locked
		end
		local char = victim.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then
			return
		end
		stunnedUntil[victim] = now + SB.StunSeconds
		hooks.onStun(victim, SB.StunSeconds)
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.JumpHeight = 0
		fx:FireAllClients("stun", char, SB.StunSeconds, thrower.Name, victim)
		task.delay(SB.StunSeconds, function()
			if hum.Parent and stunnedUntil[victim] and stunnedUntil[victim] <= os.clock() + 0.01 then
				hum.WalkSpeed = hooks.walkSpeed(victim)
				hum.JumpPower = 50
				hum.JumpHeight = 7.2
			end
		end)
	end

	function SnowballService.IsStunned(player: Player): boolean
		return (stunnedUntil[player] or 0) > os.clock()
	end

	throwRemote.OnServerEvent:Connect(function(player, dir)
		if typeof(dir) ~= "Vector3" or dir.Magnitude < 0.1 or dir.Magnitude ~= dir.Magnitude or dir.Magnitude > 1e4 then
			return
		end
		local now = os.clock()
		if now - (lastThrow[player] or 0) < SB.Cooldown or SnowballService.IsStunned(player) or not hooks.canThrow(player) then
			return
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then
			return
		end
		lastThrow[player] = now
		dir = dir.Unit
		local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
		local origin = (if hand then hand.Position else hrp.Position + Vector3.new(0, 1.5, 0)) + dir * 1.5
		local velocity = dir * SB.Speed + Vector3.new(0, SB.Speed * 0.08, 0)
		-- throw animation: the default Animate script plays its tool swing on this value
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then
			local anim = Instance.new("StringValue")
			anim.Name = "toolanim"
			anim.Value = "Slash"
			anim.Parent = tool
			task.delay(0.5, function()
				anim:Destroy()
			end)
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }
		table.insert(flying, { thrower = player, pos = origin, vel = velocity, t = 0, params = params })
		fx:FireAllClients("throw", player, origin, velocity, Workspace:GetServerTimeNow())
	end)

	RunService.Heartbeat:Connect(function(dt)
		for i = #flying, 1, -1 do
			local b = flying[i]
			b.t += dt
			local vel = b.vel + Vector3.new(0, -SB.Gravity * dt, 0)
			local step = (b.vel + vel) * 0.5 * dt
			b.vel = vel
			local hit = Workspace:Spherecast(b.pos, SB.Radius, step, b.params)
			if hit then
				table.remove(flying, i)
				if hooks.onHit and hooks.onHit(hit.Instance, b.thrower) then
					continue -- an event (like the Yeti) took the hit
				end
				local model = hit.Instance:FindFirstAncestorOfClass("Model")
				local victim = model and Players:GetPlayerFromCharacter(model)
				if victim and victim ~= b.thrower then
					stun(victim, b.thrower)
				end
			elseif b.t > SB.MaxFlightTime then
				table.remove(flying, i)
			else
				b.pos += step
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(p)
		lastThrow[p] = nil
		stunnedUntil[p] = nil
	end)
end

return SnowballService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Builds the neighbourhood (ground, roads, houses, trees, lamps, fence) and the
-- market hub (snow pile, Snow Buyer, Tool Shop, tool display, spin wheel, daily gift).
-- Returns rectangles where snow must not grow and handles to the interactive bits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Models = require(Shared.Models)

local S = Config.STUDS_PER_METER
local HALF = Config.WORLD_SIZE / 2
local FACE_PLAZA = CFrame.Angles(0, math.pi, 0) -- models face -Z; this turns them to +Z

local World = {}

local function part(parent: Instance, size: Vector3, cf: CFrame, color: string, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = Color3.fromHex(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, val in props do
			(p :: any)[k] = val
		end
	end
	p.Parent = parent
	return p
end

local function rectOverlap(a, b, margin: number): boolean
	return a[3] > b[1] - margin and a[1] < b[3] + margin and a[4] > b[2] - margin and a[2] < b[4] + margin
end

-- [x0, z0, x1, z1] in studs
World.Roads = {
	{ -HALF, 13 * S, HALF, 20 * S },
	{ -HALF, -36 * S, HALF, -29 * S },
	{ -36 * S, -HALF, -29 * S, HALF },
	{ 29 * S, -HALF, 36 * S, HALF },
}
World.Plaza = { -14 * S, -11 * S, 14 * S, 6 * S }

function World.SetupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(120, 130, 150)
	Lighting.OutdoorAmbient = Color3.fromRGB(170, 185, 210)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.32
	atmo.Offset = 0.1
	atmo.Color = Color3.fromRGB(205, 220, 240)
	atmo.Decay = Color3.fromRGB(150, 175, 210)
	atmo.Glare = 0
	atmo.Haze = 1.6
	atmo.Parent = Lighting
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.08
	cc.TintColor = Color3.fromRGB(245, 250, 255)
	cc.Parent = Lighting
end

-- distance from the town centre to the fence, in direction `a` (radians)
function World.EdgeDistance(a: number): number
	return HALF / math.max(math.abs(math.cos(a)), math.abs(math.sin(a)))
end

-- Snowy valley: a Terrain snow floor around the town and rings of rocky, snow-capped
-- mountains. Terrain is cheap to render compared with parts.
function World.BuildValley()
	local terrain = workspace.Terrain
	terrain:FillBlock(CFrame.new(0, -4, 0), Vector3.new(1600, 7.6, 1600), Enum.Material.Snow) -- top sits just under the town ground
	local rng = Random.new(2024)
	local rings = {
		{ offset = 95, count = 44, size = { 26, 42 } }, -- foothills behind the forest
		{ offset = 165, count = 36, size = { 55, 85 } }, -- mountains
		{ offset = 290, count = 26, size = { 85, 125 } }, -- big peaks far away
	}
	for _, ring in rings do
		for i = 0, ring.count - 1 do
			local a = (i + rng:NextNumber() * 0.7) / ring.count * math.pi * 2
			local r = World.EdgeDistance(a) + ring.offset + rng:NextNumber(-15, 15)
			local rad = rng:NextNumber(ring.size[1], ring.size[2])
			local c = Vector3.new(math.cos(a) * r, -rad * 0.35, math.sin(a) * r)
			terrain:FillBall(c, rad, Enum.Material.Rock)
			terrain:FillBall(c + Vector3.new(0, rad * 0.32, 0), rad * 0.78, Enum.Material.Snow) -- snow cap
		end
	end
	terrain:SetMaterialColor(Enum.Material.Snow, Color3.fromRGB(236, 243, 252))
	terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(110, 118, 130))
end

function World.Build()
	World.SetupLighting()
	local root = Instance.new("Folder")
	root.Name = "Town"
	root.Parent = workspace
	local blocks = {} -- areas without snow

	-- remove the default baseplate if there is one
	local bp = workspace:FindFirstChild("Baseplate")
	if bp then
		bp:Destroy()
	end

	-- ground, outer snowfield, roads and plaza
	part(root, Vector3.new(Config.WORLD_SIZE, 2, Config.WORLD_SIZE), CFrame.new(0, -1, 0), "#6b7d55", Enum.Material.Grass, { Name = "Ground" })
	if Config.BuildMountains then
		World.BuildValley()
	else
		part(root, Vector3.new(2000, 2, 2000), CFrame.new(0, -1.05, 0), "#e9f0fa", Enum.Material.Snow, { Name = "OuterSnow" })
	end
	for i, r in World.Roads do
		local cx, cz = (r[1] + r[3]) / 2, (r[2] + r[4]) / 2
		part(root, Vector3.new(r[3] - r[1], 0.2, r[4] - r[2]), CFrame.new(cx, 0.0, cz), "#4a4d52", Enum.Material.Asphalt, { Name = "Road" .. i })
	end
	local P = World.Plaza
	part(root, Vector3.new(P[3] - P[1], 0.3, P[4] - P[2]), CFrame.new((P[1] + P[3]) / 2, 0.05, (P[2] + P[4]) / 2), "#9c8f80", Enum.Material.Cobblestone, { Name = "Plaza" })
	table.insert(blocks, P)

	-- houses
	local rng = Random.new(1337)
	local houseColors = { "#c0504d", "#4f81bd", "#9bbb59", "#f2c14e", "#8064a2", "#e98b5a", "#5fb3b3", "#d7d2c8", "#a9746e" }
	local houses = {}
	local houseFolder = Instance.new("Folder")
	houseFolder.Name = "Houses"
	houseFolder.Parent = root
	local colliders = {}
	local function tryHouse(cxM: number, czM: number, facing: number)
		local wM, dM = 7 + rng:NextNumber() * 2, 6 + rng:NextNumber() * 1.5
		local side = math.abs(math.sin(facing)) > 0.5
		local fw, fd = (if side then dM else wM) * S, (if side then wM else dM) * S
		local cx, cz = cxM * S, czM * S
		local rect = { cx - fw / 2, cz - fd / 2, cx + fw / 2, cz + fd / 2 }
		if math.abs(cx) > HALF - 18 or math.abs(cz) > HALF - 18 then
			return
		end
		for _, r in World.Roads do
			if rectOverlap(rect, r, 3) then
				return
			end
		end
		if rectOverlap(rect, P, 18) then
			return
		end
		for _, h in houses do
			if rectOverlap(rect, h, 9) then
				return
			end
		end
		table.insert(houses, rect)
		table.insert(blocks, rect)
		local house = Models.BuildHouse(wM, dM, houseColors[rng:NextInteger(1, #houseColors)], rng:NextNumber() > 0.4)
		-- built facing -Z; `facing` is the direction the front door should point (radians about Y from +Z)
		house:PivotTo(CFrame.new(cx, 0, cz) * CFrame.Angles(0, facing + math.pi, 0))
		for _, d in house:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = d.Name ~= "Root"
				d.CanQuery = true
			end
		end
		house.Parent = houseFolder
	end
	for x = -54, 54, 11 do
		tryHouse(x, 26, math.pi)
		tryHouse(x, 6, 0)
		tryHouse(x, -42, 0)
		tryHouse(x, -22, math.pi)
		tryHouse(x, 46, math.pi)
	end
	for z = -54, 54, 11 do
		tryHouse(-46, z, math.pi / 2)
		tryHouse(-19, z, -math.pi / 2)
		tryHouse(46, z, -math.pi / 2)
		tryHouse(19, z, math.pi / 2)
	end

	-- pine trees
	local trees = Instance.new("Folder")
	trees.Name = "Trees"
	trees.Parent = root
	local spots = {}
	for _ = 1, 160 do
		if #spots >= 70 then
			break
		end
		local x = (rng:NextNumber() - 0.5) * (Config.WORLD_SIZE - 20)
		local z = (rng:NextNumber() - 0.5) * (Config.WORLD_SIZE - 20)
		local rect = { x - 3, z - 3, x + 3, z + 3 }
		local ok = not rectOverlap(rect, P, 12)
		for _, r in World.Roads do
			ok = ok and not rectOverlap(rect, r, 1)
		end
		for _, h in houses do
			ok = ok and not rectOverlap(rect, h, 4)
		end
		for _, s in spots do
			ok = ok and (s[1] - x) ^ 2 + (s[2] - z) ^ 2 > 15 * 15
		end
		if ok then
			table.insert(spots, { x, z })
			local t = Models.BuildPine(0.8 + rng:NextNumber() * 0.7)
			t:PivotTo(CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber() * 6, 0))
			local trunk = part(t, Vector3.new(2, 8, 2), CFrame.new(x, 4, z), "#000000", nil, { Transparency = 1, CanCollide = true, Name = "Collider" })
			trunk.CanQuery = false
			t.Parent = trees
		end
	end

	-- street lamps
	for xM = -50, 50, 16 do
		for _, zM in { 12, 21, -28, -37 } do
			local lamp = Models.BuildLamp()
			lamp:PivotTo(CFrame.new(xM * S, 0, zM * S))
			part(lamp, Vector3.new(1, 12, 1), CFrame.new(xM * S, 6, zM * S), "#000000", nil, { Transparency = 1, CanCollide = true, Name = "Collider" })
			lamp.Parent = root
		end
	end

	-- perimeter fence (also stops players wandering off)
	for _, sgn in { -1, 1 } do
		for _, horiz in { true, false } do
			for t = -HALF, HALF, 9 do
				local x, z = if horiz then t else sgn * HALF, if horiz then sgn * HALF else t
				local post = part(root, Vector3.new(1.2, 0.5, 0.5), CFrame.new(x, 1.9, z) * CFrame.Angles(0, 0, math.pi / 2), "#7b5a3a", Enum.Material.Wood)
				post.Shape = Enum.PartType.Cylinder
				post.Size = Vector3.new(3.9, 0.5, 0.5)
			end
			for _, y in { 1.35, 2.85 } do
				local size = if horiz then Vector3.new(Config.WORLD_SIZE, 0.3, 0.2) else Vector3.new(0.2, 0.3, Config.WORLD_SIZE)
				part(root, size, CFrame.new(if horiz then 0 else sgn * HALF, y, if horiz then sgn * HALF else 0), "#7b5a3a", Enum.Material.Wood)
			end
			-- invisible wall
			local wall = if horiz then Vector3.new(Config.WORLD_SIZE + 2, 160, 2) else Vector3.new(2, 160, Config.WORLD_SIZE + 2)
			local b = part(root, wall, CFrame.new(if horiz then 0 else sgn * (HALF + 1), 80, if horiz then sgn * (HALF + 1) else 0), "#000000", nil, { Transparency = 1, Name = "Boundary" })
			b.CanCollide = true
			b.CanQuery = false
			b.CastShadow = false
		end
	end

	-- forest between the fence and the mountains (no shadows: there are a lot of them)
	for i = 0, 139 do
		local a = (i + rng:NextNumber()) / 140 * math.pi * 2
		local r = World.EdgeDistance(a) + 14 + rng:NextNumber() * 60
		local t = Models.BuildPine(1.6 + rng:NextNumber() * 1.8)
		t:PivotTo(CFrame.new(math.cos(a) * r, 0, math.sin(a) * r) * CFrame.Angles(0, rng:NextNumber() * 6, 0))
		Models.NoShadows(t)
		t.Parent = trees
	end

	-- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 0.4, 8)
	spawn.CFrame = CFrame.new(Config.Hub.Spawn + Vector3.new(0, 0.3, 0))
	spawn.Material = Enum.Material.Cobblestone
	spawn.Color = Color3.fromHex("#9c8f80")
	spawn.Transparency = 0
	spawn.Duration = 0
	spawn.Parent = root

	local hub = World.BuildHub(root)
	return blocks, hub
end

-- ------------------------------------------------------------------ market hub
local function prompt(parent: Instance, action: string, object: string, dist: number?, key: Enum.KeyCode?): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = dist or 12
	pp.KeyboardKeyCode = key or Enum.KeyCode.E
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	return pp
end

-- Small floating text above a tool on the display: name, then price / OWNED. It is sized in
-- studs so it shrinks with distance and never covers its neighbours. The client makes the
-- tool you point at (or stand next to) bigger and brighter.
local function toolLabel(parent: Instance, title: string, subtitle: string, height: number)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromScale(3.8, 1.1) -- studs
	bb.StudsOffset = Vector3.new(0, height, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 60
	bb.LightInfluence = 0
	bb.Parent = parent
	local t = Instance.new("TextLabel")
	t.Name = "Title"
	t.Size = UDim2.fromScale(1, 0.58)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.35
	t.Text = title
	t.Parent = bb
	local s = Instance.new("TextLabel")
	s.Name = "Subtitle"
	s.Position = UDim2.fromScale(0, 0.6)
	s.Size = UDim2.fromScale(1, 0.4)
	s.BackgroundTransparency = 1
	s.Font = Enum.Font.GothamBold
	s.TextScaled = true
	s.TextColor3 = Color3.fromHex("#ffd54f")
	s.TextStrokeTransparency = 0.35
	s.Text = subtitle
	s.Parent = bb
	return bb
end

function World.BuildHub(root: Instance)
	local H = Config.Hub
	local hub = Instance.new("Folder")
	hub.Name = "Market"
	hub.Parent = root
	local out = {}

	local function stall(pos: Vector3, color: string, stripe: string, sign: string, npcColors: { string }, title: string, sub: string)
		local m = Models.BuildStall(color, stripe, sign, 3.4)
		m:PivotTo(CFrame.new(pos) * FACE_PLAZA)
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = true
			end
		end
		m.Parent = hub
		local npc = Models.BuildNPC(npcColors[1], npcColors[2], npcColors[3])
		npc:PivotTo(CFrame.new(pos + Vector3.new(0, 0, 0.15 * S)) * FACE_PLAZA)
		npc.Parent = hub
		local anchor = part(hub, Vector3.new(4, 4, 1), CFrame.new(pos + Vector3.new(0, 4, 1.4 * S)), "#000000", nil, { Transparency = 1, CanCollide = false, Name = sign .. "Prompt" })
		return anchor, npc
	end
	local sellAnchor, sellNpc = stall(H.Sell, "#1e88e5", "#e3f2fd", "SNOW BUYER", { "#1565c0", "#f9a825", "#e3f2fd" }, "SNOW BUYER", Config.SNOW_VALUE .. " coin per snow")
	local shopAnchor, shopNpc = stall(H.Shop, "#c62828", "#fff8e1", "TOOL SHOP", { "#6d4c41", "#c62828", "#43a047" }, "TOOL SHOP", "Shopping list inside!")
	out.SellPrompt = prompt(sellAnchor, "Sell snow pile", "Snow Buyer")
	out.ShopPrompt = prompt(shopAnchor, "Open shopping list", "Tool Shop")
	out.SellNpc, out.ShopNpc = sellNpc, shopNpc
	CollectionService:AddTag(sellNpc, "Vendor")
	CollectionService:AddTag(shopNpc, "Vendor")

	-- snow pile corral (the mound itself is drawn per player on the client)
	local ring = H.PileRadius + 1.4
	for i = 0, 17 do
		local a = i / 18 * math.pi * 2
		if math.abs(a - math.pi / 2) > 0.5 then
			local p = part(hub, Vector3.new(1.5, 2.4, 0.36), CFrame.new(H.Pile.X + math.cos(a) * ring, 1.2, H.Pile.Z + math.sin(a) * ring) * CFrame.Angles(0, -a + math.pi / 2, 0), "#8d6e63", Enum.Material.Wood)
			p.CanCollide = true
		end
	end
	local pileBase = part(hub, Vector3.new(0.4, H.PileRadius * 2, H.PileRadius * 2), CFrame.new(H.Pile + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), "#dfe8f3", Enum.Material.Snow, { Name = "PileBase", Shape = Enum.PartType.Cylinder, CanCollide = false })
	out.PileBase = pileBase

	-- tool display: 20 items on 4 tight tiers right beside the shop stall
	local displayFolder = Instance.new("Folder")
	displayFolder.Name = "ToolDisplay"
	displayFolder.Parent = hub
	local o, cols, sx, sz = H.DisplayOrigin, H.DisplayCols, H.DisplayStepX, H.DisplayStepZ
	local width = cols * sx + 1.2
	for r = 0, 3 do
		local hgt = (0.25 + (3 - r) * 0.28) * S
		local z = o.Z + r * sz + sz / 2
		part(displayFolder, Vector3.new(width, hgt, sz), CFrame.new(o.X + width / 2 - 0.6, hgt / 2, z), "#e8e2d6", Enum.Material.Marble, { CanCollide = true })
		part(displayFolder, Vector3.new(width, 0.2, 0.2), CFrame.new(o.X + width / 2 - 0.6, hgt, z + sz / 2 - 0.1), "#c62828")
	end

	out.Displays = {}
	for i, tool in Config.Tools do
		local fromFront = (i - 1) // 5 -- 0..3: hand tools in front, machines at the back
		local r = 3 - fromFront
		local c = (i - 1) % 5
		local hgt = (0.25 + (3 - r) * 0.28) * S
		local x = o.X + c * sx + sx / 2 - 0.6
		local z = o.Z + r * sz + sz / 2
		local holder = Instance.new("Model")
		holder.Name = "Display_" .. tool.id
		holder:SetAttribute("ToolId", tool.id)
		local ped = part(holder, Vector3.new(0.36, 3.6, 3.6), CFrame.new(x, hgt + 0.18, z) * CFrame.Angles(0, 0, math.pi / 2), if tool.kind == "hand" then "#90caf9" else "#ffcc80", Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Cylinder, Name = "Pedestal" })
		ped.CanCollide = false
		local top = hgt + 0.36
		-- the model
		local m = Models.Build(tool.id)
		if tool.kind == "hand" then
			m:PivotTo(CFrame.Angles(math.rad(-15), 0, 0))
		end
		local _, size = m:GetBoundingBox()
		local scale = if tool.kind == "hand" then math.min(1.3, 3.4 / math.max(size.Y, 0.8)) else 3.2 / math.max(size.X, size.Z)
		m:ScaleTo(scale)
		local bcf, bsize = m:GetBoundingBox()
		local pivot = m:GetPivot()
		local offset = Vector3.new(x, top, z) - Vector3.new(bcf.Position.X, bcf.Position.Y - bsize.Y / 2, bcf.Position.Z)
		m:PivotTo(pivot + offset)
		Models.NoShadows(m)
		Models.Rig(m) -- the client spins it by moving just the Root
		m.Name = "Item"
		m:SetAttribute("SpinCentre", Vector3.new(x, top, z))
		m.Parent = holder
		local hit = part(holder, Vector3.new(3.8, math.max(4, bsize.Y + 1), 3.8), CFrame.new(x, top + math.max(4, bsize.Y + 1) / 2, z), "#000000", nil, { Transparency = 1, CanCollide = false, Name = "Hit" })
		hit.CanQuery = true
		local click = Instance.new("ClickDetector")
		click.MaxActivationDistance = 80
		click.Parent = hit
		local pp = prompt(hit, "Inspect", tool.name, 7)
		pp.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
		toolLabel(hit, tool.name, Config.FormatNumber(tool.price) .. " coins", bsize.Y + 0.9 - hit.Size.Y / 2) -- just above the tool
		holder.Parent = displayFolder
		CollectionService:AddTag(holder, "ToolDisplay")
		table.insert(out.Displays, { id = tool.id, click = click, prompt = pp })
	end

	-- spin wheel stand
	local post = "#5d4037"
	part(hub, Vector3.new(0.6, 9.6, 0.6), CFrame.new(H.Wheel + Vector3.new(-4.8, 4.8, 0)), post, Enum.Material.Wood, { CanCollide = true })
	part(hub, Vector3.new(0.6, 9.6, 0.6), CFrame.new(H.Wheel + Vector3.new(4.8, 4.8, 0)), post, Enum.Material.Wood, { CanCollide = true })
	part(hub, Vector3.new(10.8, 0.9, 3), CFrame.new(H.Wheel + Vector3.new(0, 0.45, 0)), post, Enum.Material.Wood, { CanCollide = true })
	part(hub, Vector3.new(9.6, 0.4, 0.4), CFrame.new(H.Wheel + Vector3.new(0, 9.4, 0)), post, Enum.Material.Wood)
	local wheel = Models.BuildWheel(1.4)
	wheel.Name = "SpinWheel"
	wheel:PivotTo(CFrame.new(H.Wheel + Vector3.new(0, 5.7, 0.4)) * FACE_PLAZA)
	Models.Rig(wheel) -- the client turns it by moving just the Root
	wheel.Parent = hub
	CollectionService:AddTag(wheel, "SpinWheel")
	local pointer = Instance.new("WedgePart")
	pointer.Anchored = true
	pointer.Size = Vector3.new(0.3, 1.2, 0.8)
	pointer.Color = Color3.fromHex("#e53935")
	pointer.CFrame = CFrame.new(H.Wheel + Vector3.new(0, 10.2, 0.6)) * CFrame.Angles(math.pi, 0, 0) * CFrame.Angles(0, math.pi / 2, 0)
	pointer.Parent = hub
	local wheelAnchor = part(hub, Vector3.new(4, 4, 1), CFrame.new(H.Wheel + Vector3.new(0, 4, 2)), "#000000", nil, { Transparency = 1, CanCollide = false, Name = "WheelPrompt" })
	out.WheelPrompt = prompt(wheelAnchor, "Spin the wheel", "Lucky Spin")
	local wclick = Instance.new("ClickDetector")
	wclick.MaxActivationDistance = 80
	wclick.Parent = wheelAnchor
	out.WheelClick = wclick

	-- daily gift
	local gift = Models.BuildGift()
	gift:ScaleTo(1)
	gift:PivotTo(CFrame.new(H.Gift))
	gift.Parent = hub
	CollectionService:AddTag(gift, "Gift")
	local giftAnchor = part(hub, Vector3.new(3.6, 3.6, 3.6), CFrame.new(H.Gift + Vector3.new(0, 1.8, 0)), "#000000", nil, { Transparency = 1, CanCollide = true, Name = "GiftPrompt" })
	out.GiftPrompt = prompt(giftAnchor, "Claim daily reward", "Gift")
	local gclick = Instance.new("ClickDetector")
	gclick.MaxActivationDistance = 80
	gclick.Parent = giftAnchor
	out.GiftClick = gclick

	-- plaza tree and benches
	local tree = Models.BuildXmasTree()
	tree:PivotTo(CFrame.new(11.5 * S, 0, 2.2 * S))
	tree.Parent = hub
	part(hub, Vector3.new(3, 10, 3), CFrame.new(11.5 * S, 5, 2.2 * S), "#000000", nil, { Transparency = 1, CanCollide = true })
	for _, bx in { -8 * S, 6 * S } do
		local bench = Instance.new("Model")
		bench.Name = "Bench"
		local wood = "#8d6e63"
		part(bench, Vector3.new(6, 0.3, 1.8), CFrame.new(bx, 1.5, 4.6 * S), wood, Enum.Material.Wood, { CanCollide = true })
		part(bench, Vector3.new(6, 1.5, 0.24), CFrame.new(bx, 2.55, 4.6 * S + 0.84), wood, Enum.Material.Wood, { CanCollide = true })
		for _, sx2 in { -2.55, 2.55 } do
			part(bench, Vector3.new(0.24, 1.5, 1.5), CFrame.new(bx + sx2, 0.75, 4.6 * S), "#263238", Enum.Material.Metal, { CanCollide = true })
		end
		bench.Parent = hub
	end

	return out
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Clear the Snow: client entry point. It loads the UI modules, wires the side buttons,
-- handles input and listens for messages from the server.
--
--   UI/Theme.luau       colours, fonts, drawn icons (coin, arrow)
--   UI/Panels.luau      the ScreenGui and the pop-up window frame
--   UI/Hud.luau         coins, pile, load bar, side buttons, toasts
--   UI/ShopPanel.luau   shopping list
--   UI/DailyPanel.luau  daily rewards
--   UI/SpinPanel.luau   lucky spin wheel
--   UI/HelpPanel.luau   how to play
--   UI/EventBar.luau    event countdown and progress / HP bar at the top
--   Tutorial.luau       step-by-step tutorial with arrows
--   Snowballs.luau      snowball throwing (Bare Hands), flight visuals, stumble
--   WorldEffects.luau   pile mound, snowfall, display labels and turntables

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

-- ---------------------------------------------------------------- guard against old copies
-- If the place file still holds an older copy of this game's client script (for example
-- from an earlier .rbxlx), both would run and the HUD would be drawn twice. Stop any other
-- "Client" script and remove what it drew, and say where it was so it can be deleted.
local function isStrayClient(inst: Instance): boolean
	return inst ~= script and inst:IsA("LocalScript") and inst.Name == "Client"
end
local function stopStray(inst: Instance)
	warn("[ClearTheSnow] Stopped an old copy of the client script at " .. inst:GetFullName()
		.. ". Delete it in Studio (look in StarterPlayer > StarterPlayerScripts and StarterGui) so only Rojo's copy is left.")
	inst.Enabled = false
	inst:Destroy()
end
local function sweepStrays()
	local localPlayer = Players.LocalPlayer
	for _, root in { localPlayer:FindFirstChild("PlayerScripts"), localPlayer:FindFirstChild("PlayerGui"), localPlayer.Character } do
		if root then
			for _, d in root:GetDescendants() do
				if isStrayClient(d) and not d:IsDescendantOf(script.Parent) then
					stopStray(d)
				end
			end
		end
	end
	for _, c in script.Parent:GetChildren() do
		if isStrayClient(c) then
			stopStray(c)
		end
	end
end
sweepStrays()
task.delay(3, sweepStrays) -- catch copies that start a little later

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local UI = script.Parent:WaitForChild("UI")
local Panels = require(UI.Panels)
local Hud = require(UI.Hud)
local Shop = require(UI.ShopPanel)
local Daily = require(UI.DailyPanel)
local Spin = require(UI.SpinPanel)
local Help = require(UI.HelpPanel)
-- these wait for things the server makes, so load them in the background: the shop,
-- buttons and prompts must work even if one of them is still waiting
task.spawn(require, UI.EventBar)
task.spawn(require, script.Parent:WaitForChild("Tutorial"))
task.spawn(require, script.Parent:WaitForChild("Snowballs"))
local WorldEffects = require(script.Parent:WaitForChild("WorldEffects"))

local player = Players.LocalPlayer
local fmt = Config.FormatNumber

-- the game equips tools itself, so hide the default backpack bar
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- ---------------------------------------------------------------- side buttons
Hud.shopBtn.Activated:Connect(function()
	Shop.open()
end)
Hud.dailyBtn.Activated:Connect(Daily.open)
Hud.spinBtn.Activated:Connect(Spin.open)
Hud.helpBtn.Activated:Connect(Help.open)
Hud.autoBtn.Activated:Connect(function()
	Remotes.SetAuto:FireServer(not player:GetAttribute("Auto"))
end)

-- ---------------------------------------------------------------- refresh UI when attributes change
local function refresh()
	Hud.refresh()
	if Shop.panel.Visible then
		Shop.render()
	end
	if Daily.panel.Visible then
		Daily.render()
	end
	if Spin.panel.Visible and not Spin.isSpinning() then
		Spin.render()
	end
end
for _, a in { "Coins", "Load", "Capacity", "Pile", "Equipped", "Owned", "Spins", "DailyCanClaim", "Auto", "BoostSell", "BoostCapacity" } do
	player:GetAttributeChangedSignal(a):Connect(refresh)
end
task.spawn(function()
	while true do
		task.wait(1)
		refresh()
	end
end)

-- ---------------------------------------------------------------- input: hold to scoop
local held = { mouse = false, key = false, touch = false }
local function sendScoop()
	Remotes.SetScooping:FireServer(held.mouse or held.key or held.touch)
end
if Panels.isTouch then
	Hud.makeScoopButton(function(on)
		held.touch = on
		sendScoop()
	end)
end
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		held.mouse = true
		sendScoop()
	elseif input.KeyCode == Enum.KeyCode.F then
		held.key = true
		sendScoop()
	elseif input.KeyCode == Enum.KeyCode.R then
		Remotes.SetAuto:FireServer(not player:GetAttribute("Auto"))
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		held.mouse = false
		sendScoop()
	elseif input.KeyCode == Enum.KeyCode.F then
		held.key = false
		sendScoop()
	end
end)

-- ---------------------------------------------------------------- messages from the server
Remotes.Notify.OnClientEvent:Connect(function(kind, a, b)
	if kind == "toast" then
		Hud.toast(a, b)
	elseif kind == "open" then
		if a == "shop" then
			Shop.open(b)
		elseif a == "daily" then
			Daily.open()
		elseif a == "spin" then
			Spin.open()
		end
	elseif kind == "dumped" then
		Hud.floater("+" .. fmt(a) .. " snow on the pile", Color3.new(1, 1, 1))
	elseif kind == "present" then
		Hud.floater("Present! +" .. fmt(a) .. " coins", Color3.fromHex("#ffd54f"))
		Hud.toast("You opened a present: +" .. fmt(a) .. " coins!", 2.5)
	elseif kind == "sold" then
		Hud.floater("+" .. fmt(a) .. " coins")
	elseif kind == "full" then
		local tool = Config.GetTool(player:GetAttribute("Equipped") or "hands")
		Hud.toast(if tool.kind == "machine" then "Machine full! Drive to the Snow Pile." else "Hands full! Take it to the Snow Pile.")
	end
end)

-- ---------------------------------------------------------------- out-of-date place check
-- If the server scripts in this place are older than this client, say so on screen.
task.delay(8, function()
	local serverVersion = ReplicatedStorage:GetAttribute("ClearTheSnowVersion")
	if serverVersion == Config.Version then
		return
	end
	warn("[ClearTheSnow] Server scripts are version " .. tostring(serverVersion) .. " but the client is " .. tostring(Config.Version)
		.. ". This place has old copies of the game's scripts. Open the latest ClearTheSnow.rbxlx, or delete the old scripts and sync with Rojo.")
	local Theme = require(UI.Theme)
	local warnCard = Theme.new("TextButton", {
		Name = "OldScriptsWarning",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.C.bad,
		Size = UDim2.fromOffset(480, 58),
		LayoutOrder = 0,
		Font = Theme.BoldFont,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		TextWrapped = true,
		Text = "This place is running OLD game scripts, so some things won't work. Open the latest ClearTheSnow.rbxlx (or see Output). Click to hide.",
		ZIndex = 30,
		Parent = Panels.top,
	}, { Theme.corner(12), Theme.pad(8) })
	warnCard.Activated:Connect(function()
		warnCard:Destroy()
	end)
end)

-- ---------------------------------------------------------------- first load
task.spawn(function()
	while not player:GetAttribute("Ready") do
		task.wait(0.5)
	end
	refresh()
	WorldEffects.refreshDisplays()
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Snowballs</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball fights on the client: Q (or the THROW button on touch screens) throws a
-- snowball while Bare Hands are equipped. The server decides hits; this script draws
-- every snowball in flight and the stumble when someone gets hit.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Theme = require(script.Parent.UI.Theme)
local Panels = require(script.Parent.UI.Panels)
local Hud = require(script.Parent.UI.Hud)
local SB = Config.Snowball

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local ThrowRemote = Remotes:WaitForChild("ThrowSnowball")
local Fx = Remotes:WaitForChild("SnowballFx")

local Snowballs = {}

local eventState = ReplicatedStorage:WaitForChild("EventState")

-- Bare Hands can always throw; during some events (the Yeti) everyone can
local function hasHands(): boolean
	return player:GetAttribute("Equipped") == "hands" or eventState:GetAttribute("SnowballsForAll") == true
end

-- ---------------------------------------------------------------- throwing
local lastThrow = 0
local function throw()
	if not hasHands() or os.clock() - lastThrow < SB.Cooldown then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	lastThrow = os.clock()
	local dir
	if Panels.isTouch then
		dir = Workspace.CurrentCamera.CFrame.LookVector
	else
		dir = mouse.Hit.Position - (hrp.Position + Vector3.new(0, 1.5, 0))
	end
	if dir.Magnitude < 0.1 then
		dir = hrp.CFrame.LookVector
	end
	ThrowRemote:FireServer(dir.Unit)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.Q then
		throw()
	end
end)

local throwBtn
if Panels.isTouch then
	throwBtn = Theme.button({
		Text = "THROW",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -214),
		Size = UDim2.fromOffset(84, 84),
		BackgroundColor3 = Color3.fromRGB(240, 246, 255),
		Visible = false,
		Parent = Panels.gui,
	})
	throwBtn:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0)
	throwBtn.Activated:Connect(throw)
end
local function refreshButton()
	if throwBtn then
		throwBtn.Visible = hasHands()
	end
end
player:GetAttributeChangedSignal("Equipped"):Connect(refreshButton)
eventState:GetAttributeChangedSignal("SnowballsForAll"):Connect(refreshButton)
refreshButton()

-- ---------------------------------------------------------------- snowballs in flight
local function flyBall(origin: Vector3, velocity: Vector3, thrower: Player)
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(1, 1, 1) * SB.Radius * 2
	ball.Material = Enum.Material.Snow
	ball.Color = Color3.fromRGB(248, 251, 255)
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CastShadow = false
	ball.Parent = Workspace
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ball, thrower.Character }
	local pos, vel, t = origin, velocity, 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		t += dt
		local nv = vel + Vector3.new(0, -SB.Gravity * dt, 0)
		local step = (vel + nv) * 0.5 * dt
		vel = nv
		local hit = Workspace:Raycast(pos, step, params)
		if hit or t > SB.MaxFlightTime then
			conn:Disconnect()
			if hit then
				-- little puff of snow
				local puff = Instance.new("Part")
				puff.Shape = Enum.PartType.Ball
				puff.Anchored, puff.CanCollide, puff.CanQuery, puff.CanTouch = true, false, false, false
				puff.Material = Enum.Material.Snow
				puff.Color = ball.Color
				puff.Size = Vector3.new(2.2, 2.2, 2.2)
				puff.CFrame = CFrame.new(hit.Position)
				puff.Transparency = 0.3
				puff.Parent = Workspace
				game:GetService("TweenService"):Create(puff, TweenInfo.new(0.35), { Size = Vector3.new(3.6, 3.6, 3.6), Transparency = 1 }):Play()
				game:GetService("Debris"):AddItem(puff, 0.4)
			end
			ball:Destroy()
			return
		end
		pos += step
		ball.CFrame = CFrame.new(pos)
	end)
end

-- ---------------------------------------------------------------- stumble
-- Tips the character's root joint back and forth for the stun time. Every client runs
-- this for the stunned character, so everyone sees the stumble.
local function stumble(char: Model, seconds: number)
	local joint = (char:FindFirstChild("LowerTorso") and char.LowerTorso:FindFirstChild("Root"))
		or (char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart:FindFirstChild("RootJoint"))
	if not joint or not joint:IsA("Motor6D") then
		return
	end
	local isR6 = joint.Name == "RootJoint"
	local t0 = os.clock()
	local total = seconds + 0.25
	local conn
	conn = RunService.Stepped:Connect(function()
		local k = (os.clock() - t0) / total
		if k >= 1 or not joint.Parent then
			conn:Disconnect()
			return
		end
		local fade = math.sin(k * math.pi)
		local back = math.rad(-28) * fade -- lean back from the hit
		local wobble = math.rad(14) * math.sin(k * math.pi * 4) * fade
		local tilt = if isR6 then CFrame.Angles(-back, wobble, 0) else CFrame.Angles(back, 0, wobble)
		joint.Transform = joint.Transform * tilt
	end)
end

Fx.OnClientEvent:Connect(function(kind, a, b, c, d, e)
	if kind == "throw" then
		local thrower, origin, velocity, sentAt = a, b, c, d
		if typeof(origin) == "Vector3" and typeof(velocity) == "Vector3" and thrower then
			-- skip ahead by the network delay so the ball lines up with the server's
			local lag = math.clamp(Workspace:GetServerTimeNow() - (sentAt or 0), 0, 0.3)
			flyBall(origin + velocity * lag, velocity, thrower)
		end
	elseif kind == "stun" then
		local char, seconds, throwerName, victim = a, b, c, d
		if typeof(char) == "Instance" then
			stumble(char, seconds)
		end
		if victim == player then
			Hud.toast("Splat! " .. tostring(throwerName) .. " hit you with a snowball!", 1.6)
		elseif throwerName == player.Name and victim then
			Hud.floater("Direct hit on " .. victim.DisplayName .. "!", Color3.new(1, 1, 1))
		end
	end
end)

return Snowballs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Hands-on tutorial: a card at the top of the screen says what to do, a yellow arrow
-- floats over where to go, a line on the ground leads there, and an arrow at the edge of
-- the screen points the way when the target is out of view.
--
-- The server decides the current step (player attribute "Tutorial": 1..5, 0 = done) and
-- moves it on as you play. The step text lives in Config.Tutorial.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local GuiService = game:GetService("GuiService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Theme = require(script.Parent.UI.Theme)
local Panels = require(script.Parent.UI.Panels)
local Hud = require(script.Parent.UI.Hud)
local Shop = require(script.Parent.UI.ShopPanel)
local C, new, label, button = Theme.C, Theme.new, Theme.label, Theme.button
local H = Config.Hub

local player = Players.LocalPlayer
local gui = Panels.gui
local TOTAL = 4 -- steps that have a task (step 5 is the "enjoy" card)

local Tutorial = {}

-- ---------------------------------------------------------------- the step card
local card = new("Frame", {
	Name = "TutorialCard",
	BackgroundColor3 = C.panel,
	Size = UDim2.fromOffset(480, 104),
	LayoutOrder = 2, -- sits right under the event timer at the top of the screen
	Visible = false,
	ZIndex = 20,
	Parent = Panels.top,
}, { Theme.corner(16), Theme.pad(12), new("UIStroke", { Color = C.accent, Thickness = 3 }), new("UISizeConstraint", { MaxSize = Vector2.new(480, 104) }) })
local stepText = label({ Text = "STEP 1 OF 4", Size = UDim2.new(1, -80, 0, 16), TextColor3 = C.accent, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = card })
local titleText = label({ Text = "", Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 30), Font = Theme.TitleFont, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = card })
local bodyText = label({ Text = "", Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 30), Font = Theme.BodyFont, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 21, Parent = card })
local skip = button({ Text = "Skip", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(64, 24), BackgroundColor3 = C.panel2, TextColor3 = C.muted, ZIndex = 22, Parent = card })
skip.Activated:Connect(function()
	Remotes.TutorialAction:FireServer("skip")
end)

-- ---------------------------------------------------------------- arrow at the screen edge
local edgeArrow = Theme.arrow(64, C.accent, 30)
edgeArrow.Visible = false
edgeArrow.Parent = gui

-- ---------------------------------------------------------------- arrow over the target in the world
local marker = new("Part", {
	Name = "TutorialMarker",
	Anchored = true,
	CanCollide = false,
	CanQuery = false,
	CanTouch = false,
	Transparency = 1,
	Size = Vector3.new(1, 1, 1),
	Parent = Workspace,
})
local markerGui = new("BillboardGui", {
	Size = UDim2.fromOffset(170, 150),
	StudsOffsetWorldSpace = Vector3.new(0, 5, 0),
	AlwaysOnTop = true,
	LightInfluence = 0,
	MaxDistance = 1e5,
	Enabled = false,
	Parent = marker,
})
local markerLabel = label({ Text = "", Size = UDim2.new(1, 0, 0, 46), Font = Theme.TitleFont, TextStrokeTransparency = 0.2, TextColor3 = C.accent, Parent = markerGui })
local markerArrow = Theme.arrow(70, C.accent, 2)
markerArrow.Parent = markerGui

-- a glowing line on the ground from you to the target
local groundAttach = new("Attachment", { Position = Vector3.new(0, 0.4, 0), Parent = marker })
local playerAttach = new("Attachment", { Name = "TutorialBeamStart" })
local beam = new("Beam", {
	Attachment0 = playerAttach,
	Attachment1 = groundAttach,
	Color = ColorSequence.new(C.accent),
	LightEmission = 1,
	LightInfluence = 0,
	Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(0.15, 0.2), NumberSequenceKeypoint.new(1, 0.2) }),
	Width0 = 0.6,
	Width1 = 0.6,
	FaceCamera = true,
	Segments = 1,
	Enabled = false,
	Parent = marker,
})
local function hookCharacter(char: Model)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if hrp then
		playerAttach.Position = Vector3.new(0, -2.6, 0)
		playerAttach.Parent = hrp
	end
end
player.CharacterAdded:Connect(hookCharacter)
if player.Character then
	task.spawn(hookCharacter, player.Character)
end

-- ---------------------------------------------------------------- where each step points
local snowTarget: BasePart? = nil
local lastSnowSearch = 0

-- nearest tile that still has a good amount of snow on it
local function findSnow(from: Vector3): BasePart?
	local folder = Workspace:FindFirstChild("Snow")
	if not folder then
		return nil
	end
	local best, bestD = nil, math.huge
	for _, p in folder:GetChildren() do
		if p:IsA("BasePart") and p.Transparency < 0.5 and p.Size.Y > 1.4 then
			local d = (p.Position - from).Magnitude
			if d < bestD then
				best, bestD = p, d
			end
		end
	end
	return best
end

local function displayFor(id: string): BasePart?
	for _, holder in CollectionService:GetTagged("ToolDisplay") do
		if holder:GetAttribute("ToolId") == id then
			return holder:FindFirstChild("Hit")
		end
	end
	return nil
end

-- returns ground position, label, and whether to hide guidance when you're close
local function targetFor(step: number, hrp: BasePart): (Vector3?, string?, boolean)
	if step == 1 then
		local now = os.clock()
		if not snowTarget or snowTarget.Size.Y < 0.8 or snowTarget.Transparency > 0.5 or now - lastSnowSearch > 4 then
			lastSnowSearch = now
			snowTarget = findSnow(hrp.Position)
		end
		if snowTarget then
			return Vector3.new(snowTarget.Position.X, 0, snowTarget.Position.Z), "SNOW", true
		end
		return nil, nil, true
	elseif step == 2 then
		return H.Pile, "SNOW PILE", false
	elseif step == 3 then
		return H.Sell + Vector3.new(0, 0, 4), "SNOW BUYER", false
	elseif step == 4 then
		local id = Shop.nextToolId()
		local hit = id and displayFor(id)
		if hit then
			return Vector3.new(hit.Position.X, 0, hit.Position.Z), "BUY: " .. Config.GetTool(id).name, false
		end
		return H.Shop + Vector3.new(0, 0, 4), "TOOL SHOP", false
	end
	return nil, nil, false
end

-- ---------------------------------------------------------------- card text
local function stepInfo(step: number)
	local s = Config.Tutorial.Steps[step]
	if not s then
		return "", ""
	end
	local text = if Panels.isTouch and s.touchText then s.touchText else s.text
	if step == 4 then
		local id = Shop.nextToolId()
		text = string.format(text, if id then Config.GetTool(id).name else "next tool")
	end
	return s.title, text
end

local current = -1
local function showStep(step: number)
	if step == current then
		return
	end
	local prev = current
	current = step
	snowTarget = nil
	if step >= 1 and step <= 5 then
		local title, text = stepInfo(step)
		titleText.Text = title
		bodyText.Text = text
		stepText.Text = if step <= TOTAL then "STEP " .. step .. " OF " .. TOTAL else "TUTORIAL COMPLETE"
		skip.Visible = step <= TOTAL
		card.Visible = true
		if prev >= 1 and step > prev then
			Hud.floater(if step == 5 then "Enjoy the game!" else "Nice! Next step", C.good)
		end
	else
		card.Visible = false
	end
end

local function hideGuides()
	markerGui.Enabled = false
	beam.Enabled = false
	edgeArrow.Visible = false
end

-- place the edge arrow so it points toward a world position that is off screen
local function pointEdgeArrow(world: Vector3): boolean
	local cam = Workspace.CurrentCamera
	local vp = cam.ViewportSize
	local sp = cam:WorldToViewportPoint(world)
	local margin = 70
	local onScreen = sp.Z > 0 and sp.X > margin and sp.X < vp.X - margin and sp.Y > margin and sp.Y < vp.Y - margin
	if onScreen then
		return false
	end
	local centre = vp / 2
	local dir = Vector2.new(sp.X, sp.Y) - centre
	if sp.Z <= 0 then
		dir = -dir -- behind the camera: the projection is mirrored
	end
	if dir.Magnitude < 1 then
		dir = Vector2.new(0, 1)
	end
	local t = math.min((vp.X / 2 - margin) / math.max(math.abs(dir.X), 1e-3), (vp.Y / 2 - margin) / math.max(math.abs(dir.Y), 1e-3))
	local pos = centre + dir * t
	local inset = GuiService:GetGuiInset() -- viewport space -> this ScreenGui's space
	edgeArrow.Position = UDim2.fromOffset(pos.X - inset.X, pos.Y - inset.Y)
	edgeArrow.Rotation = math.deg(math.atan2(dir.Y, dir.X)) - 90
	edgeArrow.Visible = true
	return true
end

RunService.RenderStepped:Connect(function()
	local step = player:GetAttribute("Tutorial") or 0
	showStep(step)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		hideGuides()
		return
	end
	local bob = math.sin(os.clock() * 5) * 8
	markerArrow.Position = UDim2.new(0.5, 0, 0, 82 + bob)

	-- in the shop during step 4: point at the Buy button of the next tool
	if step == 4 and Shop.panel.Visible then
		markerGui.Enabled = false
		beam.Enabled = false
		local id = Shop.nextToolId()
		local c = id and Shop.visibleCard(id)
		if c then
			local b = c:FindFirstChild("Action")
			local p = b.AbsolutePosition + Vector2.new(b.AbsoluteSize.X / 2, -34 + bob * 0.6)
			edgeArrow.Position = UDim2.fromOffset(p.X, p.Y)
			edgeArrow.Rotation = 0
			edgeArrow.Visible = true
		else
			edgeArrow.Visible = false
		end
		return
	end

	local pos, name, hideNear
	if step >= 1 and step <= TOTAL then
		pos, name, hideNear = targetFor(step, hrp)
	elseif step == 0 then
		-- after the tutorial: a gentle reminder when your tool is full
		local load = player:GetAttribute("Load") or 0
		local cap = player:GetAttribute("Capacity") or 1
		if load >= cap and load > 0 then
			pos, name, hideNear = H.Pile, "SNOW PILE", false
		end
	end
	if not pos or Panels.anyOpen() then
		hideGuides()
		return
	end
	local flat = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
	local dist = (flat - Vector3.new(pos.X, 0, pos.Z)).Magnitude
	marker.CFrame = CFrame.new(pos.X, 0, pos.Z)
	if hideNear and dist < 9 then
		hideGuides()
		return
	end
	markerLabel.Text = name .. "\n" .. math.floor(dist) .. " studs"
	markerGui.Enabled = true
	beam.Enabled = step > 0 and dist > 12
	if step > 0 then
		if not pointEdgeArrow(pos + Vector3.new(0, 5, 0)) then
			edgeArrow.Visible = false
		end
	else
		edgeArrow.Visible = false
	end
end)

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="22">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">DailyPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Daily rewards: a 7-day streak calendar and a Claim button.
-- Reward amounts are set in Config.DailyRewards.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Theme = require(script.Parent.Theme)
local Panels = require(script.Parent.Panels)
local Hud = require(script.Parent.Hud)
local C, new, label, button = Theme.C, Theme.new, Theme.label, Theme.button
local fmt = Config.FormatNumber

local player = Players.LocalPlayer

local Daily = {}

local panel = Panels.make("Daily", "Daily Rewards", Vector2.new(520, 420))
Daily.panel = panel
label({ Text = "Come back every day to keep your streak. Day 7 is the big one!", Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 20), Font = Theme.BodyFont, TextColor3 = C.muted, ZIndex = 11, Parent = panel })
local grid = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 200), ZIndex = 11, Parent = panel }, {
	new("UIGridLayout", { CellSize = UDim2.new(0.25, -8, 0, 92), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local cells = {}
for i = 1, #Config.DailyRewards do
	local cell = new("Frame", { BackgroundColor3 = if i == 7 then Color3.fromHex("#7a4fd0") else C.panel2, LayoutOrder = i, ZIndex = 11, Parent = grid }, { Theme.corner(12), Theme.pad(6) })
	label({ Text = "Day " .. i, Size = UDim2.new(1, 0, 0, 16), TextColor3 = C.muted, ZIndex = 12, Parent = cell })
	Theme.coin(16, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 20), ZIndex = 12, Parent = cell })
	label({ Name = "Reward", Text = "", Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 30), TextWrapped = true, ZIndex = 12, Parent = cell })
	label({ Name = "Check", Text = "CLAIMED", Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 14), TextColor3 = C.good, Visible = false, ZIndex = 12, Parent = cell })
	new("UIStroke", { Color = C.accent, Thickness = 3, Enabled = false, Parent = cell })
	cells[i] = cell
end
local claimBtn = button({ Text = "Claim", Position = UDim2.new(0, 0, 1, -86), Size = UDim2.new(1, 0, 0, 48), ZIndex = 11, Parent = panel })
local info = label({ Text = "", Position = UDim2.new(0, 0, 1, -30), Size = UDim2.new(1, 0, 0, 20), Font = Theme.BodyFont, TextColor3 = C.muted, ZIndex = 11, Parent = panel })

function Daily.render()
	local can = player:GetAttribute("DailyCanClaim")
	local idx = player:GetAttribute("DailyIndex") or 1
	local progress = player:GetAttribute("ProgressCoins") or 10
	for i, r in Config.DailyRewards do
		local cell = cells[i]
		local coins = math.max(r.min, math.floor(progress * r.pct + 0.5))
		cell.Reward.Text = fmt(coins) .. " coins" .. (if r.spins > 0 then "\n+" .. r.spins .. " spin" .. (if r.spins > 1 then "s" else "") else "")
		local done = if can then i < idx else i <= idx
		cell.Check.Visible = done
		cell.BackgroundTransparency = if done then 0.5 else 0
		cell:FindFirstChildOfClass("UIStroke").Enabled = can and i == idx
	end
	claimBtn.Text = if can then "Claim Day " .. idx else "Claimed today"
	claimBtn.BackgroundColor3 = if can then C.accent else C.disabled
	claimBtn.Active = can == true
	local streak = player:GetAttribute("DailyStreak") or 0
	if can and player:GetAttribute("DailyBroken") then
		info.Text = "Your streak reset. Start again today!"
	elseif can then
		info.Text = "Current streak: " .. streak .. " day" .. (if streak == 1 then "" else "s")
	else
		info.Text = "Streak: " .. streak .. "  |  next reward in " .. Panels.untilTomorrow()
	end
end

claimBtn.Activated:Connect(function()
	if not player:GetAttribute("DailyCanClaim") then
		return
	end
	local rw = Remotes.ClaimDaily:InvokeServer()
	if rw then
		Hud.toast("+" .. fmt(rw.coins) .. " coins" .. (if rw.spins > 0 then " and +" .. rw.spins .. " spin" .. (if rw.spins > 1 then "s" else "") else "") .. "!")
	end
	task.wait(0.15)
	Daily.render()
end)

function Daily.open()
	Panels.closeAll()
	Daily.render()
	panel.Visible = true
end

return Daily
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="24">
            <Properties>
              <string name="Name">EventBar</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The event bar at the top of the screen: a countdown to the next event, then the
-- current event's name, time left and its progress (green) or HP (red) bar.
-- It reads attributes on ReplicatedStorage.EventState, set by the server's EventService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local Panels = require(script.Parent.Panels)
local C, new, label = Theme.C, Theme.new, Theme.label

local state = ReplicatedStorage:WaitForChild("EventState")

local EventBar = {}

local frame = new("Frame", {
	Name = "EventBar",
	BackgroundColor3 = C.panel,
	BorderSizePixel = 0,
	Size = UDim2.fromOffset(250, 34),
	LayoutOrder = 1,
	ZIndex = 18,
	Parent = Panels.top,
}, { Theme.corner(12) })
-- square off the top corners so the bar sits flush against the top edge
new("Frame", { BackgroundColor3 = C.panel, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 14), ZIndex = 18, Parent = frame })
local title = label({ Text = "", Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 22), Font = Theme.TitleFont, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 19, Parent = frame })
local timer = label({ Text = "", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(70, 22), Font = Theme.TitleFont, TextColor3 = C.accent, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 19, Parent = frame })
local bar = new("Frame", { BackgroundColor3 = Color3.fromRGB(10, 22, 44), Position = UDim2.fromOffset(12, 34), Size = UDim2.new(1, -24, 0, 24), ClipsDescendants = true, Visible = false, ZIndex = 19, Parent = frame }, { Theme.corner(10) })
local fill = new("Frame", { BackgroundColor3 = C.good, Size = UDim2.fromScale(0, 1), ZIndex = 20, Parent = bar }, { Theme.corner(10) })
local barText = label({ Text = "", Position = UDim2.fromScale(0, 0.1), Size = UDim2.fromScale(1, 0.8), ZIndex = 21, TextStrokeTransparency = 0.4, Parent = bar })

local function clock(secs: number): string
	secs = math.max(0, math.floor(secs))
	return string.format("%d:%02d", secs // 60, secs % 60)
end

RunService.RenderStepped:Connect(function()
	local now = Workspace:GetServerTimeNow()
	if state:GetAttribute("Phase") == "active" then
		frame.Size = UDim2.fromOffset(420, 66)
		title.Text = state:GetAttribute("Title") or "Event"
		title.Size = UDim2.new(1, -100, 0, 22)
		timer.Visible = true
		timer.Text = clock((state:GetAttribute("EndsAt") or now) - now)
		bar.Visible = true
		local hp = state:GetAttribute("BarKind") == "hp"
		fill.BackgroundColor3 = if hp then C.bad else C.good
		fill.Size = UDim2.fromScale(state:GetAttribute("Progress") or 0, 1)
		barText.Text = state:GetAttribute("BarText") or ""
	else
		local nextAt = state:GetAttribute("NextAt")
		frame.Size = UDim2.fromOffset(250, 34)
		title.Size = UDim2.new(1, -24, 0, 22)
		title.Text = if nextAt then "Next event in " .. clock(nextAt - now) else "Events starting soon"
		timer.Visible = false
		bar.Visible = false
	end
end)

return EventBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">HelpPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- "How to play" window, opened from the Help button. Can restart the tutorial.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Theme = require(script.Parent.Theme)
local Panels = require(script.Parent.Panels)
local C, label, button = Theme.C, Theme.label, Theme.button

local Help = {}

local panel = Panels.make("Help", "Clear the Snow", Vector2.new(520, 440))
Help.panel = panel
label({
	Text = "1. Walk into the snow and hold click (or F) to scoop it up. Each tool only carries so much.\n\n"
		.. "2. Bring it to the Snow Pile at the market. You toss it in when you get close.\n\n"
		.. "3. Walk up to the Snow Buyer and press E to sell your whole pile for coins.\n\n"
		.. "4. The Tool Shop is right next door. Walk up to a tool on the display, or press Shop.\n\n"
		.. "5. Snow grows back, so keep clearing! Claim your daily reward and free spin every day.",
	Position = UDim2.fromOffset(0, 46),
	Size = UDim2.new(1, 0, 1, -116),
	Font = Theme.BodyFont,
	TextScaled = false,
	TextSize = 17,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	ZIndex = 11,
	Parent = panel,
})
local replay = button({ Text = "Replay tutorial", Position = UDim2.new(0, 0, 1, -54), Size = UDim2.new(0.5, -6, 0, 50), BackgroundColor3 = C.panel2, TextColor3 = C.text, ZIndex = 11, Parent = panel })
local go = button({ Text = "Let's go!", Position = UDim2.new(0.5, 6, 1, -54), Size = UDim2.new(0.5, -6, 0, 50), ZIndex = 11, Parent = panel })
replay.Activated:Connect(function()
	Remotes.TutorialAction:FireServer("replay")
	panel.Visible = false
end)
go.Activated:Connect(function()
	panel.Visible = false
end)

function Help.open()
	Panels.closeAll()
	panel.Visible = true
end

return Help
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Always-on-screen HUD: coins, pile, active boosts, the load bar, side buttons,
-- toasts and floating "+5" numbers. Panels hook into the side buttons from Client.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)
local Panels = require(script.Parent.Panels)
local C, new, label = Theme.C, Theme.new, Theme.label
local fmt = Config.FormatNumber

local player = Players.LocalPlayer
local gui = Panels.gui

local Hud = {}

-- ---------------------------------------------------------------- top left: coins, pile, boosts
local top = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(260, 200), Parent = gui }, {
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local function pill(order: number, height: number)
	return new("Frame", { BackgroundColor3 = C.panel, BackgroundTransparency = 0.05, Size = UDim2.fromOffset(200, height), LayoutOrder = order, Parent = top }, { Theme.corner(height // 2) })
end
local coinPill = pill(1, 46)
Theme.coin(30, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Parent = coinPill })
local coinText = label({ Text = "0", Position = UDim2.fromOffset(46, 7), Size = UDim2.new(1, -58, 1, -14), Font = Theme.TitleFont, TextXAlignment = Enum.TextXAlignment.Left, Parent = coinPill })
local pilePill = pill(2, 34)
-- a little white snow mound as the pile icon
new("Frame", { BackgroundColor3 = Color3.fromRGB(235, 243, 255), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -8), Size = UDim2.fromOffset(26, 14), Parent = pilePill }, {
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
})
local pileText = label({ Text = "Pile: 0", Position = UDim2.fromOffset(44, 6), Size = UDim2.new(1, -54, 1, -12), TextXAlignment = Enum.TextXAlignment.Left, Parent = pilePill })
local boostsFrame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(200, 70), LayoutOrder = 3, Parent = top }, {
	new("UIListLayout", { Padding = UDim.new(0, 4) }),
})

-- ---------------------------------------------------------------- bottom: tool + load bar
local bottom = new("Frame", {
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.fromOffset(420, 84),
	Parent = gui,
}, { new("UISizeConstraint", { MaxSize = Vector2.new(420, 84) }) })
local toolText = label({ Text = "Bare Hands", Size = UDim2.new(1, 0, 0, 24), Font = Theme.TitleFont, TextStrokeTransparency = 0.5, Parent = bottom })
local bar = new("Frame", { BackgroundColor3 = C.panel, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 28), ClipsDescendants = true, Parent = bottom }, { Theme.corner(14) })
local barFill = new("Frame", { BackgroundColor3 = Color3.fromRGB(220, 238, 255), Size = UDim2.fromScale(0, 1), Parent = bar }, { Theme.corner(14) })
local barText = label({ Text = "0 / 1 snow", Size = UDim2.fromScale(1, 0.8), Position = UDim2.fromScale(0, 0.1), TextColor3 = C.ink, ZIndex = 2, Parent = bar })
local hint = label({
	Text = if Panels.isTouch then "Hold SCOOP in the snow" else "Hold click or F to scoop  |  R = auto-scoop",
	Size = UDim2.new(1, 0, 0, 18),
	Position = UDim2.fromOffset(0, 62),
	Font = Theme.BodyFont,
	TextColor3 = C.ink,
	TextStrokeColor3 = Color3.new(1, 1, 1),
	TextStrokeTransparency = 0.3,
	Parent = bottom,
})

-- ---------------------------------------------------------------- right side buttons
local side = new("Frame", {
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -12, 0.5, 0),
	Size = UDim2.fromOffset(96, 340),
	Parent = gui,
}, { new("UIListLayout", { Padding = UDim.new(0, 10), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })

local function sideButton(order: number, text: string, color: Color3)
	local b = new("TextButton", { BackgroundColor3 = C.panel, Size = UDim2.fromOffset(92, 54), Text = "", AutoButtonColor = true, LayoutOrder = order, Parent = side }, { Theme.corner(14) })
	new("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -6), Size = UDim2.new(1, 0, 0, 6), Parent = b }, { Theme.corner(3) })
	local t = label({ Name = "Label", Text = text, Font = Theme.TitleFont, Position = UDim2.fromOffset(6, 10), Size = UDim2.new(1, -12, 1, -22), Parent = b })
	local badge = new("TextLabel", {
		BackgroundColor3 = C.bad,
		Size = UDim2.fromOffset(24, 24),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Font = Theme.BoldFont,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		Text = "!",
		Visible = false,
		ZIndex = 3,
		Parent = b,
	}, { Theme.round() })
	return b, badge, t
end
Hud.shopBtn = sideButton(1, "Shop", C.accent)
Hud.dailyBtn, Hud.dailyBadge = sideButton(2, "Daily", C.good)
Hud.spinBtn, Hud.spinBadge = sideButton(3, "Spin", C.blue)
local autoBtn, _, autoLabel = sideButton(4, "Auto: Off", Color3.fromHex("#9b6ce0"))
Hud.autoBtn = autoBtn
Hud.helpBtn = sideButton(5, "Help", C.muted)

-- ---------------------------------------------------------------- toast + floaters
local toast = new("TextLabel", {
	BackgroundColor3 = C.panel,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.fromScale(0.5, 0.3),
	Size = UDim2.fromOffset(440, 64),
	Font = Theme.TitleFont,
	TextColor3 = C.text,
	TextScaled = true,
	Visible = false,
	ZIndex = 40,
	Parent = gui,
}, { Theme.corner(14), Theme.pad(10) })
local toastToken = 0
function Hud.toast(text: string, secs: number?)
	toastToken += 1
	local my = toastToken
	toast.Text = text
	toast.Visible = true
	task.delay(secs or 2.4, function()
		if toastToken == my then
			toast.Visible = false
		end
	end)
end

function Hud.floater(text: string, color: Color3?)
	local f = label({
		Text = text,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(320, 44),
		Font = Theme.TitleFont,
		TextColor3 = color or C.accent,
		TextStrokeTransparency = 0.2,
		ZIndex = 35,
		Parent = gui,
	})
	TweenService:Create(f, TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.fromScale(0.5, 0.4),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	task.delay(1.4, function()
		f:Destroy()
	end)
end

-- ---------------------------------------------------------------- touch SCOOP button
-- onChange(held) is called when the button is pressed or released
function Hud.makeScoopButton(onChange: (boolean) -> ())
	local tb = new("TextButton", {
		BackgroundColor3 = Color3.fromRGB(191, 227, 255),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -110, 1, -110),
		Size = UDim2.fromOffset(96, 96),
		Font = Theme.TitleFont,
		Text = "SCOOP",
		TextColor3 = C.ink,
		TextScaled = true,
		Parent = gui,
	}, { Theme.round(), Theme.pad(14) })
	tb.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			onChange(true)
		end
	end)
	tb.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			onChange(false)
		end
	end)
end

-- ---------------------------------------------------------------- refresh from player attributes
function Hud.refresh()
	local coins = player:GetAttribute("Coins") or 0
	local load = player:GetAttribute("Load") or 0
	local cap = player:GetAttribute("Capacity") or 1
	coinText.Text = fmt(coins)
	pileText.Text = "Pile: " .. fmt(player:GetAttribute("Pile") or 0)
	local tool = Config.GetTool(player:GetAttribute("Equipped") or "hands")
	toolText.Text = tool.name
	local fill = math.clamp(load / cap, 0, 1)
	barFill.Size = UDim2.fromScale(fill, 1)
	barFill.BackgroundColor3 = if fill >= 0.999 then Color3.fromHex("#ff8a8a") else Color3.fromRGB(220, 238, 255)
	barText.Text = fmt(load) .. " / " .. fmt(cap) .. " snow" .. (if fill >= 0.999 then "  (FULL)" else "")
	Hud.dailyBadge.Visible = player:GetAttribute("DailyCanClaim") == true
	local spins = player:GetAttribute("Spins") or 0
	Hud.spinBadge.Visible = spins > 0
	Hud.spinBadge.Text = tostring(spins)
	autoLabel.Text = if player:GetAttribute("Auto") then "Auto: On" else "Auto: Off"

	-- boost timers: reuse one label per boost instead of rebuilding them every update
	local now = Workspace:GetServerTimeNow()
	for i, b in { { "BoostSell", "2x Sell", C.accent }, { "BoostCapacity", "2x Capacity", C.good } } do
		local left = (player:GetAttribute(b[1]) or 0) - now
		local tag = boostsFrame:FindFirstChild(b[1])
		if left > 0 then
			if not tag then
				tag = new("TextLabel", {
					Name = b[1],
					LayoutOrder = i,
					BackgroundColor3 = b[3],
					Size = UDim2.fromOffset(170, 26),
					Font = Theme.BoldFont,
					TextScaled = true,
					TextColor3 = C.ink,
					Parent = boostsFrame,
				}, { Theme.corner(8), Theme.pad(4) })
			end
			tag.Text = string.format("%s  %d:%02d", b[2], math.floor(left / 60), math.floor(left % 60))
		elseif tag then
			tag:Destroy()
		end
	end
	local hands = player:GetAttribute("Equipped") == "hands"
		or game:GetService("ReplicatedStorage"):FindFirstChild("EventState") and game:GetService("ReplicatedStorage").EventState:GetAttribute("SnowballsForAll") == true
	if Panels.isTouch then
		hint.Text = if hands then "Hold SCOOP in the snow  |  THROW a snowball" else "Hold SCOOP in the snow"
	else
		hint.Text = "Hold click or F to scoop  |  R = auto-scoop" .. (if hands then "  |  Q = throw snowball" else "")
	end
	hint.Visible = not Panels.isTouch or not player:GetAttribute("Auto")
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The ScreenGui every UI piece lives in, plus the pop-up panel frame used by the
-- Shop, Daily Rewards, Spin and Help windows.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)
local C, new, label, button = Theme.C, Theme.new, Theme.label, Theme.button

local player = Players.LocalPlayer

local Panels = {}

-- remove HUDs (and leftovers) drawn by an old copy of the client script, now and later
local playerGui = player:WaitForChild("PlayerGui")
local function removeOldGui(g: Instance)
	if g:IsA("ScreenGui") and g.Name == "ClearTheSnowUI" and g ~= Panels.gui then
		g:Destroy()
	end
end
for _, g in playerGui:GetChildren() do
	removeOldGui(g)
end
for _, name in { "PileArrow" } do
	local old = Workspace:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end

Panels.gui = new("ScreenGui", {
	Name = "ClearTheSnowUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})
playerGui.ChildAdded:Connect(function(g)
	task.defer(removeOldGui, g)
end)
-- The strip at the very top of the screen (event timer, tutorial card). It ignores the
-- top-bar inset so it sits flush against the top edge; items stack downward in order.
Panels.topGui = new("ScreenGui", {
	Name = "ClearTheSnowTop",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 2,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})
Panels.top = new("Frame", {
	Name = "TopStack",
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.fromScale(0.5, 0),
	Size = UDim2.fromOffset(480, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	Parent = Panels.topGui,
}, {
	new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
})
for _, g in playerGui:GetChildren() do
	if g:IsA("ScreenGui") and g.Name == "ClearTheSnowTop" and g ~= Panels.topGui then
		g:Destroy()
	end
end

Panels.isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local all: { [string]: Frame } = {}
Panels.locked = false -- true while the spin wheel is turning, so panels can't close

-- A centred window with a title and a close button. Content goes inside the returned frame,
-- starting about 44px from the top.
function Panels.make(name: string, title: string, size: Vector2)
	local p = new("Frame", {
		Name = name,
		BackgroundColor3 = C.panel,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		Visible = false,
		ZIndex = 10,
		Parent = Panels.gui,
	}, { Theme.corner(20), Theme.pad(16), new("UISizeConstraint", { MaxSize = size }), new("UIScale") })
	label({ Name = "Title", Text = title, Size = UDim2.new(1, -50, 0, 34), Font = Theme.TitleFont, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, Parent = p })
	local close = button({ Name = "Close", Text = "X", Size = UDim2.fromOffset(36, 36), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), BackgroundColor3 = C.panel2, TextColor3 = C.text, ZIndex = 11, Parent = p })
	close.Activated:Connect(function()
		if not Panels.locked then
			p.Visible = false
		end
	end)
	all[name] = p
	Panels.fit()
	return p
end

function Panels.closeAll()
	if Panels.locked then
		return
	end
	for _, p in all do
		p.Visible = false
	end
end

function Panels.anyOpen(): boolean
	for _, p in all do
		if p.Visible then
			return true
		end
	end
	return false
end

-- shrink panels to fit small screens
function Panels.fit()
	local vp = Workspace.CurrentCamera.ViewportSize
	for _, p in all do
		local s = math.min(1, (vp.X - 24) / p.Size.X.Offset, (vp.Y - 60) / p.Size.Y.Offset)
		p:FindFirstChildOfClass("UIScale").Scale = math.max(0.45, s)
	end
end
Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(Panels.fit)

-- seconds until the next UTC day, as "5h 12m"
function Panels.untilTomorrow(): string
	local t = Workspace:GetServerTimeNow()
	local left = 86400 - (t % 86400)
	return string.format("%dh %dm", math.floor(left / 3600), math.floor((left % 3600) / 60))
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The Tool Shop's shopping list: two tabs (hand tools / machines) of cards with a 3D
-- preview, stats and a Buy / Equip button.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Models = require(Shared.Models)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Theme = require(script.Parent.Theme)
local Panels = require(script.Parent.Panels)
local Hud = require(script.Parent.Hud)
local C, new, label, button = Theme.C, Theme.new, Theme.label, Theme.button
local fmt = Config.FormatNumber

local player = Players.LocalPlayer

local Shop = {}

local panel = Panels.make("Shop", "Tool Shop - Shopping List", Vector2.new(900, 560))
Shop.panel = panel
local tab = "hand"
-- your coins, top right next to the close button
local wallet = new("Frame", { BackgroundColor3 = C.panel2, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -46, 0, 2), Size = UDim2.fromOffset(150, 32), ZIndex = 11, Parent = panel }, { Theme.corner(16) })
Theme.coin(22, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), ZIndex = 12, Parent = wallet })
local walletText = label({ Text = "0", Position = UDim2.fromOffset(34, 5), Size = UDim2.new(1, -42, 1, -10), Font = Theme.TitleFont, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, Parent = wallet })
local tabs = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 40), ZIndex = 11, Parent = panel }, {
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }),
})
local tabHand = button({ Text = "Hand Tools", Size = UDim2.new(0.5, -4, 1, 0), ZIndex = 11, Parent = tabs })
local tabMachine = button({ Text = "Machines", Size = UDim2.new(0.5, -4, 1, 0), ZIndex = 11, Parent = tabs })
local list = new("ScrollingFrame", {
	BackgroundTransparency = 1,
	Position = UDim2.fromOffset(0, 94),
	Size = UDim2.new(1, 0, 1, -94),
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 8,
	ZIndex = 11,
	Parent = panel,
}, {
	new("UIGridLayout", { CellSize = UDim2.fromOffset(165, 300), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
})
Shop.list = list

function Shop.ownedSet(): { [string]: boolean }
	local s = {}
	for id in string.gmatch(player:GetAttribute("Owned") or "hands", "[^,]+") do
		s[id] = true
	end
	return s
end

-- the next tool the player can buy, or nil when they own everything
function Shop.nextToolId(): string?
	local owned = Shop.ownedSet()
	for _, t in Config.Tools do
		if not owned[t.id] then
			return t.id
		end
	end
	return nil
end

-- 3D thumbnail of a model in a ViewportFrame
local function thumbnail(id: string, parent: Instance)
	local vf = new("ViewportFrame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 0, 149),
		Ambient = Color3.fromRGB(180, 190, 210),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -2, -1),
		ZIndex = 12,
		Parent = parent,
	}, {
		Theme.corner(10),
		new("UIGradient", { -- soft blue backdrop, like the web version's cards
			Color = ColorSequence.new(Color3.fromHex("#3d5f8f"), Color3.fromHex("#1c3354")),
			Rotation = 90,
		}),
	})
	local m = Models.Build(id)
	if Config.GetTool(id).kind == "hand" then
		m:PivotTo(CFrame.Angles(-0.3, 0.6, 0.5))
	else
		m:PivotTo(CFrame.Angles(0, 0.7, 0))
	end
	m.Parent = vf
	local cf, size = m:GetBoundingBox()
	local radius = size.Magnitude / 2
	local cam = new("Camera", { FieldOfView = 30, Parent = vf })
	local dir = Vector3.new(0.35, 0.45, -1).Unit
	local dist = radius / math.tan(math.rad(15)) * 1.02
	cam.CFrame = CFrame.lookAt(cf.Position + dir * dist, cf.Position)
	vf.CurrentCamera = cam
	return vf
end

local cards: { [string]: Frame } = {}
local focused: string? = nil

-- one row of two stats, e.g. "Carries 10" on the left and "Width 2.4m" on the right
local function hex(c: Color3): string
	return string.format("#%02x%02x%02x", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
end
local function statRow(y: number, parent: Instance, leftName: string, leftValue: string, rightName: string, rightValue: string)
	local function cell(text, align)
		label({
			Text = text,
			RichText = true,
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, 0, 0, 15),
			Font = Theme.BodyFont,
			TextColor3 = C.text,
			TextXAlignment = align,
			ZIndex = 12,
			Parent = parent,
		})
	end
	local a = hex(C.accent)
	cell(string.format('%s <font color="%s"><b>%s</b></font>', leftName, a, leftValue), Enum.TextXAlignment.Left)
	cell(string.format('%s <font color="%s"><b>%s</b></font>', rightName, a, rightValue), Enum.TextXAlignment.Right)
end

function Shop.render()
	tabHand.BackgroundColor3 = if tab == "hand" then C.accent else C.panel2
	tabHand.TextColor3 = if tab == "hand" then C.ink else C.text
	tabMachine.BackgroundColor3 = if tab == "machine" then C.accent else C.panel2
	tabMachine.TextColor3 = if tab == "machine" then C.ink else C.text
	local owned = Shop.ownedSet()
	local coins = player:GetAttribute("Coins") or 0
	walletText.Text = fmt(coins)
	local equipped = player:GetAttribute("Equipped")
	for i, tool in Config.Tools do
		local card = cards[tool.id]
		if not card then
			card = new("Frame", { BackgroundColor3 = C.panel2, LayoutOrder = i, ZIndex = 11, Parent = list }, { Theme.corner(14), Theme.pad(8) })
			thumbnail(tool.id, card)
			label({ Name = "ToolName", Text = i .. ". " .. tool.name, Position = UDim2.fromOffset(0, 154), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, Parent = card })
			label({ Text = tool.desc, Position = UDim2.fromOffset(0, 174), Size = UDim2.new(1, 0, 0, 28), Font = Theme.BodyFont, TextColor3 = C.muted, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 12, Parent = card })
			statRow(206, card, "Carries", fmt(tool.capacity), "Width", string.format("%.1fm", tool.radius * 2 / Config.STUDS_PER_METER))
			statRow(224, card, "Scoop", tostring(tool.rate) .. "/s", "Speed", tostring(tool.speed))
			local b = button({ Name = "Action", Text = "", Position = UDim2.new(0, 0, 1, -34), Size = UDim2.new(1, 0, 0, 34), ZIndex = 12, Parent = card })
			new("UIStroke", { Color = C.accent, Thickness = 3, Enabled = false, Parent = card })
			Theme.coin(18, { Name = "Coin", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Visible = false, ZIndex = 13, Parent = b })
			b.Activated:Connect(function()
				local ok, msg = Remotes.BuyTool:InvokeServer(tool.id)
				if msg then
					Hud.toast(msg)
				end
				task.wait(0.1)
				Shop.render()
				if ok and (player:GetAttribute("Tutorial") or 0) == 5 then
					Panels.closeAll() -- let the "Enjoy the game!" card show
				end
			end)
			cards[tool.id] = card
		end
		card.Visible = tool.kind == tab
		local b = card.Action
		local prevOwned = i == 1 or owned[Config.Tools[i - 1].id]
		if equipped == tool.id then
			b.Text = "Equipped"
			b.BackgroundColor3 = C.disabled
			b.Active = false
		elseif owned[tool.id] then
			b.Text = "Equip"
			b.BackgroundColor3 = C.blue
			b.Active = true
		elseif not prevOwned then
			b.Text = "Buy " .. Config.Tools[i - 1].name .. " first"
			b.BackgroundColor3 = C.disabled
			b.Active = false
		else
			b.Text = "    Buy " .. fmt(tool.price)
			b.BackgroundColor3 = if coins >= tool.price then C.good else C.disabled
			b.Active = true
		end
		b.Coin.Visible = owned[tool.id] ~= true and prevOwned == true and equipped ~= tool.id
		b.TextColor3 = if b.BackgroundColor3 == C.blue then Color3.new(1, 1, 1) else C.ink
		card.BackgroundTransparency = if not owned[tool.id] and not prevOwned then 0.45 else 0
		card:FindFirstChildOfClass("UIStroke").Enabled = tool.id == focused
	end
end

tabHand.Activated:Connect(function()
	tab = "hand"
	Shop.render()
end)
tabMachine.Activated:Connect(function()
	tab = "machine"
	Shop.render()
end)

-- the card for a tool, if it's on the visible tab (used by the tutorial arrow)
function Shop.visibleCard(id: string): Frame?
	local c = cards[id]
	if panel.Visible and c and c.Visible then
		return c
	end
	return nil
end

function Shop.open(focus: string?)
	Panels.closeAll()
	if not focus and (player:GetAttribute("Tutorial") or 0) == 4 then
		focus = Shop.nextToolId()
	end
	focused = focus
	if focus then
		tab = Config.GetTool(focus).kind
	end
	Shop.render()
	panel.Visible = true
	if focus and cards[focus] then
		task.defer(function()
			local c = cards[focus]
			local y = c.AbsolutePosition.Y - list.AbsolutePosition.Y + list.CanvasPosition.Y
			list.CanvasPosition = Vector2.new(0, math.max(0, y - 10))
		end)
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">SpinPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Lucky Spin. The wheel on screen is the same 3D wheel model as the one in the plaza,
-- shown in a ViewportFrame, with the prize names drawn on top. Both wheels turn together.
-- Prizes and their chances are set in Config.Wheel.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Models = require(Shared.Models)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Theme = require(script.Parent.Theme)
local Panels = require(script.Parent.Panels)
local Hud = require(script.Parent.Hud)
local C, new, label, button = Theme.C, Theme.new, Theme.label, Theme.button
local fmt = Config.FormatNumber

local player = Players.LocalPlayer

local Spin = {}

local panel = Panels.make("Spin", "Lucky Spin", Vector2.new(480, 580))
Spin.panel = panel

local WHEEL_PX = 360
local holder = new("Frame", {
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 62),
	Size = UDim2.fromOffset(WHEEL_PX, WHEEL_PX),
	ZIndex = 11,
	Parent = panel,
})
-- dark backing disc so the wheel edge reads cleanly
new("Frame", { BackgroundColor3 = Color3.fromRGB(10, 22, 44), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.02, 1.02), ZIndex = 11, Parent = holder }, { Theme.round() })

-- the 3D wheel
local RADIUS_M = 1
local view = new("ViewportFrame", {
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	Ambient = Color3.fromRGB(210, 210, 210),
	LightColor = Color3.fromRGB(255, 255, 255),
	LightDirection = Vector3.new(0.3, -0.5, 1),
	ZIndex = 12,
	Parent = holder,
})
local uiWheel = Models.BuildWheel(RADIUS_M)
uiWheel:PivotTo(CFrame.new())
uiWheel.Parent = view
local rim = RADIUS_M * Config.STUDS_PER_METER + 0.2
local cam = new("Camera", { FieldOfView = 30, Parent = view })
cam.CFrame = CFrame.lookAt(Vector3.new(0, 0, -rim / math.tan(math.rad(15))), Vector3.zero)
view.CurrentCamera = cam

-- prize names, laid out to match the model: segment i is (i - 1) * 45 degrees clockwise from the top
local nSeg = #Config.Wheel
local segDeg = 360 / nSeg
local labels = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 13, Parent = holder })
for i, s in Config.Wheel do
	local a = math.rad((i - 1) * segDeg)
	label({
		Text = s.label,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5 + math.sin(a) * 0.29, 0.5 - math.cos(a) * 0.29),
		Size = UDim2.fromScale(0.34, 0.085),
		Rotation = (i - 1) * segDeg - 90,
		Font = Theme.TitleFont,
		TextStrokeTransparency = 0.3,
		ZIndex = 14,
		Parent = labels,
	})
end
-- pointer at the top
local pointer = Theme.arrow(46, C.bad, 16)
pointer.Position = UDim2.new(0.5, 0, 0, 4)
pointer.Parent = holder

local spinBtn = button({ Text = "Spin!", Position = UDim2.new(0, 0, 1, -100), Size = UDim2.new(1, 0, 0, 50), ZIndex = 11, Parent = panel })
local info = label({ Text = "", Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(1, 0, 0, 34), Font = Theme.BodyFont, TextColor3 = C.muted, TextWrapped = true, ZIndex = 11, Parent = panel })

local spinning = false
function Spin.render()
	local n = player:GetAttribute("Spins") or 0
	local free = player:GetAttribute("FreeSpin")
	spinBtn.Text = if spinning then "Spinning..." elseif free then "Free Spin!" elseif n > 0 then "Spin! (" .. n .. " left)" else "No spins left"
	spinBtn.BackgroundColor3 = if not spinning and n > 0 then C.accent else C.disabled
	local base = math.max(10, math.floor((player:GetAttribute("ProgressCoins") or 10) * 0.1 + 0.5))
	info.Text = if n == 0
		then "Free spin resets in " .. Panels.untilTomorrow() .. ". Daily rewards give bonus spins."
		else "Coin prizes right now: " .. fmt(base) .. " up to " .. fmt(base * 25) .. " coins"
end

-- the 3D wheel in the plaza turns with this one
local plazaWheel, plazaBase
task.spawn(function()
	plazaWheel = CollectionService:GetTagged("SpinWheel")[1]
	while not plazaWheel do
		task.wait(1)
		plazaWheel = CollectionService:GetTagged("SpinWheel")[1]
	end
	plazaBase = plazaWheel.PrimaryPart.CFrame
end)

local angle = 0 -- degrees, clockwise as you look at the wheel
local function setWheel(deg: number)
	angle = deg
	local rot = CFrame.Angles(0, 0, math.rad(deg))
	if panel.Visible then
		uiWheel:PivotTo(rot)
		labels.Rotation = deg
	end
	if plazaWheel and plazaBase then
		plazaWheel.PrimaryPart.CFrame = plazaBase * rot
	end
end

spinBtn.Activated:Connect(function()
	if spinning or (player:GetAttribute("Spins") or 0) <= 0 then
		return
	end
	spinning = true
	Panels.locked = true
	Spin.render()
	local result = Remotes.Spin:InvokeServer()
	if not result then
		spinning = false
		Panels.locked = false
		Spin.render()
		return
	end
	local start = angle
	local want = -(result.index - 1) * segDeg + (math.random() - 0.5) * segDeg * 0.6
	local finish = start + 360 * 6 + (want - start) % 360
	local t0, dur = os.clock(), 4.2
	while true do
		local k = math.min(1, (os.clock() - t0) / dur)
		setWheel(start + (finish - start) * (1 - (1 - k) ^ 4))
		if k >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
	setWheel(angle % 360)
	spinning = false
	Panels.locked = false
	Hud.toast(Config.Wheel[result.index].label .. "!\n" .. result.message, 3)
	Spin.render()
end)

-- slow idle turn while nobody is spinning
RunService.RenderStepped:Connect(function(dt)
	if not spinning and (panel.Visible or plazaBase) then
		setWheel((angle + dt * 10) % 360)
	end
end)

function Spin.open()
	Panels.closeAll()
	Spin.render()
	panel.Visible = true
	setWheel(angle)
end

function Spin.isSpinning(): boolean
	return spinning
end

return Spin
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Colours, fonts and small helpers for building UI in code.
-- Change the look of the whole game's UI from here.
--
-- Note: Roblox fonts don't include emoji or most symbols (they show up as empty boxes),
-- so every icon in this game is drawn from plain frames instead of text characters.

local Theme = {}

Theme.C = {
	panel = Color3.fromRGB(18, 36, 66),
	panel2 = Color3.fromRGB(32, 58, 98),
	accent = Color3.fromHex("#ffd54f"),
	good = Color3.fromHex("#3cc48a"),
	bad = Color3.fromHex("#e0505a"),
	blue = Color3.fromHex("#4fa3e0"),
	disabled = Color3.fromRGB(93, 109, 134),
	text = Color3.fromRGB(243, 247, 255),
	muted = Color3.fromRGB(169, 187, 214),
	ink = Color3.fromRGB(15, 30, 55),
	coin = Color3.fromHex("#ffca28"),
	coinEdge = Color3.fromHex("#e09a00"),
}
local C = Theme.C

Theme.TitleFont = Enum.Font.FredokaOne
Theme.BodyFont = Enum.Font.Gotham
Theme.BoldFont = Enum.Font.GothamBold

-- new("Frame", { props }, { children })
function Theme.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	for k, v in props or {} do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	for _, c in children or {} do
		c.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local new = Theme.new

function Theme.corner(r: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end
function Theme.round()
	return new("UICorner", { CornerRadius = UDim.new(1, 0) })
end
function Theme.pad(px: number)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

local function merge(base, props)
	for k, v in props do
		base[k] = v
	end
	return base
end

function Theme.label(props)
	return new("TextLabel", merge({
		BackgroundTransparency = 1,
		Font = Theme.BoldFont,
		TextColor3 = C.text,
		TextScaled = true,
	}, props))
end

function Theme.button(props)
	return new("TextButton", merge({
		AutoButtonColor = true,
		BackgroundColor3 = C.accent,
		Font = Theme.TitleFont,
		TextColor3 = C.ink,
		TextScaled = true,
	}, props), { Theme.corner(12) })
end

-- A gold coin drawn from two circles. `size` in pixels.
function Theme.coin(size: number, props: { [string]: any }?)
	local c = new("Frame", merge({ BackgroundColor3 = C.coinEdge, Size = UDim2.fromOffset(size, size) }, props or {}), { Theme.round() })
	new("Frame", {
		BackgroundColor3 = C.coin,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.72, 0.72),
		ZIndex = c.ZIndex,
		Parent = c,
	}, { Theme.round() })
	return c
end

-- An arrow drawn from frames. It points DOWN; set the returned frame's Rotation to aim it
-- (0 = down, 90 = left, 180 = up, -90 = right). `size` in pixels.
function Theme.arrow(size: number, color: Color3?, z: number?)
	color = color or C.accent
	z = z or 1
	local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z })
	local function shape(col: Color3, grow: number, zi: number)
		-- shaft
		new("Frame", {
			BackgroundColor3 = col,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.02, -grow),
			Size = UDim2.new(0.3, grow * 2, 0.55, grow * 2),
			ZIndex = zi,
			Parent = holder,
		}, { Theme.corner(math.floor(size * 0.06)) })
		-- head: a square turned 45 degrees, its lower half forms the point
		new("Frame", {
			BackgroundColor3 = col,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.6),
			Size = UDim2.new(0.52, grow * 2, 0.52, grow * 2),
			Rotation = 45,
			ZIndex = zi,
			Parent = holder,
		}, { Theme.corner(math.floor(size * 0.05)) })
	end
	shape(Color3.fromRGB(20, 30, 50), math.max(2, math.floor(size * 0.05)), z)
	shape(color, 0, z + 1)
	return holder
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WorldEffects</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Local-only effects in the world: your own snow pile mound, falling snow, the
-- price / owned labels on the tool display, and the display turntables.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.UI.Theme)
local Shop = require(script.Parent.UI.ShopPanel)
local C, new = Theme.C, Theme.new
local fmt = Config.FormatNumber
local H = Config.Hub

local player = Players.LocalPlayer

local WorldEffects = {}

-- your own pile mound (each player sees their own pile)
local mound = new("Part", {
	Name = "MyPile",
	Anchored = true,
	CanCollide = false,
	CanQuery = false,
	CanTouch = false,
	Material = Enum.Material.Snow,
	Color = Color3.fromRGB(246, 250, 255),
	Size = Vector3.new(H.PileRadius * 2, 0.4, H.PileRadius * 2),
	CFrame = CFrame.new(H.Pile),
	Parent = Workspace,
}, { new("SpecialMesh", { MeshType = Enum.MeshType.Sphere }) })

-- falling snow around the camera
local snowEmitterPart = new("Part", {
	Name = "Snowfall",
	Anchored = true,
	CanCollide = false,
	CanQuery = false,
	CanTouch = false,
	Transparency = 1,
	Size = Vector3.new(140, 1, 140),
	Parent = Workspace,
})
new("ParticleEmitter", {
	Texture = "rbxasset://textures/particles/sparkles_main.dds",
	Color = ColorSequence.new(Color3.new(1, 1, 1)),
	LightEmission = 0.4,
	Size = NumberSequence.new(0.35),
	Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.6) }),
	Lifetime = NumberRange.new(8, 12),
	Rate = 150,
	Speed = NumberRange.new(5, 8),
	SpreadAngle = Vector2.new(15, 15),
	Acceleration = Vector3.new(0.6, 0, 0.3),
	EmissionDirection = Enum.NormalId.Bottom,
	RotSpeed = NumberRange.new(-40, 40),
	Parent = snowEmitterPart,
})

-- display labels: price, OWNED or EQUIPPED
local function labelOf(holder: Instance)
	local hit = holder:FindFirstChild("Hit")
	return hit and hit:FindFirstChild("Label")
end

function WorldEffects.refreshDisplays()
	local owned = Shop.ownedSet()
	local equipped = player:GetAttribute("Equipped")
	for _, holder in CollectionService:GetTagged("ToolDisplay") do
		local id = holder:GetAttribute("ToolId")
		local bb = labelOf(holder)
		local sub = bb and bb:FindFirstChild("Subtitle")
		if sub then
			local tool = Config.GetTool(id)
			sub.Text = if equipped == id then "EQUIPPED" elseif owned[id] then "OWNED" else fmt(tool.price) .. " coins"
			sub.TextColor3 = if owned[id] then Color3.fromHex("#b9f6ca") else C.accent
		end
	end
end

-- The tool you point at (or stand closest to) on the display is "selected": its label grows,
-- turns gold and shows on top, and the tool gets a glowing outline.
local highlight = new("Highlight", {
	Name = "DisplayHighlight",
	FillColor = Color3.fromHex("#ffd54f"),
	FillTransparency = 0.75,
	OutlineColor = Color3.fromHex("#ffd54f"),
	OutlineTransparency = 0,
	DepthMode = Enum.HighlightDepthMode.Occluded,
	Enabled = false,
	Parent = Workspace,
})
local mouse = player:GetMouse()
local selected: Instance? = nil
local function setSelected(holder: Instance?)
	if holder == selected then
		return
	end
	if selected then
		local bb = labelOf(selected)
		if bb then
			bb.Size = UDim2.fromScale(3.8, 1.1)
			bb.AlwaysOnTop = false
			bb.Title.TextColor3 = Color3.new(1, 1, 1)
		end
	end
	selected = holder
	if holder then
		local bb = labelOf(holder)
		if bb then
			bb.Size = UDim2.fromScale(6.5, 1.9)
			bb.AlwaysOnTop = true
			bb.Title.TextColor3 = C.accent
		end
		highlight.Adornee = holder:FindFirstChild("Item")
		highlight.Enabled = true
	else
		highlight.Enabled = false
		highlight.Adornee = nil
	end
end

local function findSelected(): Instance?
	-- pointing at a tool (or its invisible click box)
	local target = mouse.Target
	while target and target ~= Workspace do
		if target:GetAttribute("ToolId") then
			return target
		end
		target = target.Parent
	end
	-- otherwise the closest one within a few steps
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	local best, bestD = nil, 9
	for _, holder in CollectionService:GetTagged("ToolDisplay") do
		local hit = holder:FindFirstChild("Hit")
		if hit then
			local d = (Vector3.new(hit.Position.X, hrp.Position.Y, hit.Position.Z) - hrp.Position).Magnitude
			if d < bestD then
				best, bestD = holder, d
			end
		end
	end
	return best
end
task.spawn(function()
	while true do
		task.wait(0.1)
		setSelected(findSelected())
	end
end)
player:GetAttributeChangedSignal("Owned"):Connect(WorldEffects.refreshDisplays)
player:GetAttributeChangedSignal("Equipped"):Connect(WorldEffects.refreshDisplays)
task.delay(2, WorldEffects.refreshDisplays)

-- turntables
local turntables = {}
local function addTurntable(holder: Instance)
	local item = holder:WaitForChild("Item", 10)
	if item and item:IsA("Model") then
		local centre = item:GetAttribute("SpinCentre")
		local pivot = item.PrimaryPart.CFrame
		table.insert(turntables, { root = item.PrimaryPart, centre = centre, offset = CFrame.new(centre):Inverse() * pivot, phase = #turntables })
	end
end
for _, h in CollectionService:GetTagged("ToolDisplay") do
	task.spawn(addTurntable, h)
end
CollectionService:GetInstanceAddedSignal("ToolDisplay"):Connect(addTurntable)

local tAcc = 0
RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	local cam = Workspace.CurrentCamera
	snowEmitterPart.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 40, 0))
	-- pile mound grows with your pile
	local pile = player:GetAttribute("Pile") or 0
	local h = math.min(9, 0.4 + math.log10(1 + pile) * 2.4)
	local cur = mound.Size.Y
	if math.abs(h * 2 - cur) > 0.02 then -- only resize while it's actually growing
		local y = cur + (h * 2 - cur) * math.min(1, dt * 4)
		mound.Size = Vector3.new(H.PileRadius * 2, y, H.PileRadius * 2)
		mound.CFrame = CFrame.new(H.Pile + Vector3.new(0, 0.3, 0))
	end
	-- turntables (throttled, only near the camera)
	tAcc += dt
	if tAcc > 1 / 20 then
		tAcc = 0
		for _, tt in turntables do
			if (cam.CFrame.Position - tt.centre).Magnitude < 90 then
				tt.root.CFrame = CFrame.new(tt.centre) * CFrame.Angles(0, t * 0.5 + tt.phase, 0) * tt.offset
			end
		end
	end
end)

return WorldEffects
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>