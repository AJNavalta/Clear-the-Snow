		headlight(g, 0.08, -0.6, 0.8, 1.82)
		headlight(g, 0.08, 0.6, 0.8, 1.82)
		beacon(g, 0.6, 2.55, 1.7)
		cylY(g, 0.05, 0.5, M.chrome, 0.85, 1.65, -1.6)
		for _, p in { { -1.0, 1.2 }, { 1.0, 1.2 }, { -1.0, -1.2 }, { 1.0, -1.2 } } do
