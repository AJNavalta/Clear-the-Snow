		seat(g, -0.55, 1.55, -1.45, 1, "#1565c0")
		steering(g, -0.55, 1.95, -0.95, 0.5)
		box(g, 0.6, 0.6, 0.12, M.dark, -0.55, 1.75, -0.8)
